{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "mkdir -p prisma && cp ../api/prisma/schema.prisma prisma/schema.prisma && PRISMA_GENERATE_SKIP_AUTOINSTALL=1 prisma generate && node scripts/db-sync.mjs && next build --webpack",
    "postinstall": "mkdir -p prisma && cp ../api/prisma/schema.prisma prisma/schema.prisma && PRISMA_GENERATE_SKIP_AUTOINSTALL=1 prisma generate",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@google/genai": "^2.23.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "@prisma/adapter-pg": "5.22.0",
    "@prisma/client": "^5.0.0",
    "@tailwindcss/forms": "^0.5.11",
    "aws4fetch": "^1.0.20",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.19.0",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-themes": "^0.3.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-phone-number-input": "^3.4.18",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.7.2",
    "sonner": "^2.0.8",
    "stripe": "^15.12.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^5.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.142.0"
  },
  "overrides": {
    "next-themes": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
