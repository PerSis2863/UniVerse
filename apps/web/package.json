{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-excalidraw-assets.mjs && node scripts/copy-mediapipe-assets.mjs && node scripts/copy-pdfjs-assets.mjs && next dev --webpack",
    "build": "PRISMA_GENERATE_SKIP_AUTOINSTALL=1 prisma generate && node scripts/gen-owner-schema.mjs && node scripts/copy-excalidraw-assets.mjs && node scripts/copy-mediapipe-assets.mjs && node scripts/copy-pdfjs-assets.mjs && next build --webpack",
    "postinstall": "PRISMA_GENERATE_SKIP_AUTOINSTALL=1 prisma generate",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p cloudflare/tsconfig.json",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && wrangler d1 migrations apply universe-db --remote && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "db:migrate:local": "wrangler d1 migrations apply universe-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply universe-db --remote",
    "db:seed:local": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@excalidraw/excalidraw": "0.18.1",
    "@google/genai": "^2.23.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@prisma/adapter-d1": "6.19.3",
    "@prisma/client": "^6.19.3",
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tiptap/extension-collaboration": "3.31.4",
    "@tiptap/extension-collaboration-caret": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/y-tiptap": "3.0.9",
    "aws4fetch": "^1.0.20",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "date-fns": "^4.4.0",
    "ethers": "6.17.0",
    "firebase": "^12.19.0",
    "framer-motion": "^13.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "next": "16.3.8",
    "next-themes": "^0.3.0",
    "pdfjs-dist": "^5.7.284",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-phone-number-input": "^3.4.18",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "stripe": "^15.12.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^3.23.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.142.0"
  },
  "overrides": {
    "next-themes": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
