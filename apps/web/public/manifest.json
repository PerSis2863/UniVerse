{
  "name": "UniVerse Impact",
  "short_name": "UniVerse",
  "description": "The all-in-one university management platform for students, teachers, and administrators.",
  "id": "/",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "background_color": "#171f44",
  "theme_color": "#171f44",
  "orientation": "portrait-primary",
  "categories": ["education", "productivity"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "/icon-192x192.png?v=2",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512x512.png?v=2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.png?v=2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png?v=2",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "My Grades",
      "short_name": "Grades",
      "description": "View your academic grades",
      "url": "/student/grades",
      "icons": [{ "src": "/icon-192x192.png?v=2", "sizes": "192x192" }]
    },
    {
      "name": "Messages",
      "short_name": "Inbox",
      "description": "Open your messages inbox",
      "url": "/student/inbox",
      "icons": [{ "src": "/icon-192x192.png?v=2", "sizes": "192x192" }]
    },
    {
      "name": "Calendar",
      "short_name": "Calendar",
      "description": "View your academic calendar",
      "url": "/student/calendar",
      "icons": [{ "src": "/icon-192x192.png?v=2", "sizes": "192x192" }]
    },
    {
      "name": "My Courses",
      "short_name": "Courses",
      "description": "Browse your enrolled courses",
      "url": "/student/courses",
      "icons": [{ "src": "/icon-192x192.png?v=2", "sizes": "192x192" }]
    }
  ],
  "screenshots": [
    { "src": "/screenshots/wide-campus.jpg", "sizes": "1280x800", "type": "image/jpeg", "form_factor": "wide", "label": "UniVersity: the school day runs itself" },
    { "src": "/screenshots/wide-trace.jpg", "sizes": "1280x800", "type": "image/jpeg", "form_factor": "wide", "label": "UniVerse Trace: every product gets a passport" },
    { "src": "/screenshots/phone-campus.jpg", "sizes": "780x1688", "type": "image/jpeg", "form_factor": "narrow", "label": "UniVersity: the school day runs itself" },
    { "src": "/screenshots/phone-trace.jpg", "sizes": "780x1688", "type": "image/jpeg", "form_factor": "narrow", "label": "UniVerse Trace: every product gets a passport" },
    { "src": "/screenshots/phone-relief.jpg", "sizes": "780x1688", "type": "image/jpeg", "form_factor": "narrow", "label": "UniVerse Relief: help that reaches people fast" },
    { "src": "/screenshots/phone-green.jpg", "sizes": "780x1688", "type": "image/jpeg", "form_factor": "narrow", "label": "UniVerse Green: climate action you can prove" },
    { "src": "/screenshots/phone-play.jpg", "sizes": "780x1688", "type": "image/jpeg", "form_factor": "narrow", "label": "UniVerse Play: games that teach something" }
  ],
  "share_target": {
    "action": "/api/share-in",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url", "files": [{ "name": "photos", "accept": ["image/*"] }] }
  },
  "prefer_related_applications": false
}
