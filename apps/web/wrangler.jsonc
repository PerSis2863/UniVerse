{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "universe-web",
  "main": ".open-next/worker.js",
  // Keeps the upload under the Workers size limit (3 MB gzipped on the free plan).
  "minify": true,
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference, required by OpenNext; must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "universe-web"
    }
  ],
  "d1_databases": [
    {
      // The app's database. Replace database_id with the ID from `wrangler d1 create universe-db`.
      "binding": "DB",
      "database_name": "universe-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "prisma/migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
  // Secrets (DATABASE_URL, STRIPE_SECRET_KEY, R2_*, GEMINI_API_KEY, …) are set with
  // `wrangler secret put` or in the Cloudflare dashboard — never here. See DEPLOY-CLOUDFLARE.md.
}
