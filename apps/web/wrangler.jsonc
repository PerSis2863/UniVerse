{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "universe-web",
  // Wraps the Next.js app (.open-next/worker.js) and adds live updates and the daily cron job.
  "main": "cloudflare/worker.ts",
  // Keeps the upload under the Workers size limit (3 MB gzipped on the free plan).
  "minify": true,
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Run the Worker close to the D1 database rather than the visitor: a page's API calls make many
  // database round trips, which is much faster next to the database. Static files are still
  // served from the edge.
  "placement": { "mode": "smart" },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference, required by OpenNext; must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "universe-web"
    }
  ],
  "d1_databases": [
    {
      // The app's database (Cloudflare D1).
      "binding": "DB",
      "database_name": "universe-db",
      "database_id": "a48e71c9-d645-416c-a5b4-35a997dd0f79",
      "migrations_dir": "prisma/migrations"
    }
  ],
  "ratelimits": [
    {
      // All API calls: 300 per minute per signed-in user (per IP address when signed out).
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      // Flood guard: 1,500 API calls per minute from one IP address (a campus can share one).
      "name": "IP_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 1500, "period": 60 }
    },
    {
      // AI answers, uploads and support emails: 20 per minute per user (they cost money).
      "name": "COSTLY_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        // Live updates: one per signed-in user, holding their open tabs' WebSockets.
        "name": "REALTIME",
        "class_name": "RealtimeHub"
      }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RealtimeHub"] }],
  "triggers": {
    // Daily at 08:00 UTC (13:30 in India): reminders for quizzes due in the next 24 hours.
    "crons": ["0 8 * * *"]
  },
  "observability": {
    "enabled": true
  }
  // Secrets (DATABASE_URL, STRIPE_SECRET_KEY, R2_*, GEMINI_API_KEY, …) are set with
  // `wrangler secret put` or in the Cloudflare dashboard — never here. See DEPLOY-CLOUDFLARE.md.
}
