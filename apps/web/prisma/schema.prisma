// ─── FEATURE 10: BUILT-IN CERTIFICATION SYSTEM ─────────────────────────────

enum CertificateStatus {
  DRAFT
  ISSUED
  REVOKED
}

model ImpactCertificate {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  certificateCode String            @unique
  title           String
  projectName     String
  organization    String
  hoursCompleted  Int               @default(0)
  peopleImpacted  Int               @default(0)
  description     String?
  status          CertificateStatus @default(ISSUED)
  blockchainHash  String?
  issuedAt        DateTime          @default(now())
  expiresAt       DateTime?
  linkedinUrl     String?

  // Verification & signing (Phase 1: trustworthy credentials)
  // DRAFT = requested by student, awaiting admin verification.
  evidenceUrl    String?
  requestedAt    DateTime  @default(now())
  verifiedById   String?
  verifiedByName String?
  signature      String? // Ed25519 signature (base64url) over the canonical credential payload
  signatureAlg   String? // e.g. "Ed25519"
  signingKeyId   String? // fingerprint of the public key that signed it
  revokedAt      DateTime?
  revokedReason  String?

  // Public blockchain anchoring (Polygon): the credential hash is written into a transaction
  anchorStatus  String? // PENDING | CONFIRMED | FAILED
  anchorTxHash  String?
  anchorChainId Int?
  anchorNetwork String? // e.g. "Polygon Amoy (testnet)"
  anchoredAt    DateTime?
  anchorError   String?

  @@index([userId])
  @@index([certificateCode])
  @@index([status])
  @@index([anchorStatus])
  @@map("impact_certificates")
}

/// Errors seen in browsers and on the server, grouped: the same problem is one row with a count.
/// Diagnosed by AI (the daily job or the owner console) and shown to the owner at /console.
model ErrorReport {
  id          String    @id @default(cuid())
  fingerprint String    @unique // hash of source + kind + normalised message + first stack frame
  source      String // CLIENT, SERVER
  kind        String // runtime, promise, render, api, chunk
  message     String
  stack       String?
  path        String? // page or API path, no query string
  userAgent   String?
  lastUserId  String?
  count       Int       @default(1)
  users       Int       @default(1) // rough number of different people affected
  status      String    @default("NEW") // NEW, DIAGNOSED, RESOLVED, IGNORED
  diagnosis   String? // AI: likely cause, where to look, suggested fix
  severity    String? // AI: low, medium, high
  diagnosedAt DateTime?
  resolvedAt  DateTime?
  firstSeen   DateTime  @default(now())
  lastSeen    DateTime  @default(now())
  // An AI agent asked to repair it (src/server/repair-agents.ts): which one, the GitHub issue it works from, when.
  repairAgent String?
  repairUrl   String?
  repairAt    DateTime?

  @@index([status, lastSeen])
  @@map("error_reports")
}

/// How one person's call went (src/components/call/CallView.tsx → POST /api/calls/:id/stat), for the
/// owner console's Calls tab: connection numbers only, never what was said or shown.
model CallStat {
  id         String   @id @default(cuid())
  callId     String
  userId     String
  type       String // chat, group, class, room
  mode       String // p2p, sfu
  peers      Int      @default(0) // most other people at once
  seconds    Int      @default(0) // time connected to someone
  setupMs    Int? // from "Join" to the first connection
  worstRttMs Int?
  worstLoss  Float? // 0..1, packets lost in the worst reading
  relay      Boolean  @default(false) // went through the TURN relay
  audioOnly  Boolean  @default(false) // the audio-only fallback switched on
  failure    String? // media, ticket, connect, dropped
  device     String? // "Chrome on Mac"
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([callId])
  @@map("call_stats")
}

/// Machine translations of chat messages, one per message and language, shared by everyone in the
/// conversation (so a group of 30 costs one translation, not 30). Deleted when the message is edited.
model MessageTranslation {
  id         String   @id @default(cuid())
  messageId  String
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  lang       String // target language (ISO 639-1)
  sourceLang String // detected language of the original
  text       String // the translation; empty when the message was already in `lang`
  createdAt  DateTime @default(now())

  @@unique([messageId, lang])
  @@map("message_translations")
}

// Skills passport: a public page a student can choose to share (verified credentials, skills,
// courses), and Open Badges 3.0 exports of their credentials.
model SkillPassport {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug            String    @unique // random, part of the public link
  isPublic        Boolean   @default(false)
  headline        String?
  showSkills      Boolean   @default(true)
  showCredentials Boolean   @default(true)
  showCourses     Boolean   @default(false)
  showImpact      Boolean   @default(true)
  showEvidence    Boolean   @default(true)
  /// A short strengths paragraph (AI draft the student can edit)
  strengths       String?
  strengthsAt     DateTime?
  views           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("skill_passports")
}

/// Proof of learning (upgrade 2): a skill backed by something checked by someone else, created
/// automatically when an assignment is graded (60%+), a quiz is passed (60%+) or an impact
/// credential is issued. The student can hide items from their public passport.
model SkillEvidence {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill          String // normalised key (lower case, single spaces)
  label          String // as shown
  kind           String // QUIZ | ASSIGNMENT | COURSE | IMPACT | PROJECT
  sourceId       String
  title          String
  detail         String?
  level          String? // Developing | Proficient | Advanced
  verifiedById   String?
  verifiedByName String?
  occurredAt     DateTime @default(now())
  hidden         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([userId, kind, sourceId, skill])
  @@index([userId, skill])
  @@map("skill_evidence")
}

// Early warning: students who may be struggling in a course, found each day from attendance,
// grades, missed quizzes and inactivity (plain rules, no AI). Only teachers and admins see them,
// and a person decides what to do — nothing happens to the student automatically.
model StudentRiskFlag {
  id            String        @id @default(cuid())
  studentId     String
  student       User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  score         Int // 0–100
  level         String // AT_RISK | WATCH | OK (improved since it was flagged)
  reasons       Json // [{ code, text }]
  status        String        @default("OPEN") // OPEN | CONTACTED | RESOLVED | DISMISSED
  note          String?
  handledById   String?
  handledByName String?
  handledAt     DateTime?
  handledScore  Int? // score when it was last handled (reopens only if it gets clearly worse)
  followUpScore Int? // score at the 7-day follow-up of a support plan (upgrade 3)
  plans         SupportPlan[]
  computedAt    DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([status])
  @@map("student_risk_flags")
}

/// Early help (upgrade 3): a study plan a teacher made for a student after an early-warning flag.
/// The student sees it in their Study planner as encouragement (never as a warning); the teacher is
/// reminded in the app after 7 days and sees whether things improved.
model SupportPlan {
  id                 String           @id @default(cuid())
  flagId             String?
  flag               StudentRiskFlag? @relation(fields: [flagId], references: [id], onDelete: SetNull)
  studentId          String
  student            User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId           String
  createdById        String
  createdByName      String
  plan               String // JSON { intro, steps: [{ title, detail, minutes }], closing }
  message            String? // the teacher's note to the student
  stepsDone          String           @default("[]") // JSON number[]: steps the student ticked
  status             String           @default("ACTIVE") // ACTIVE | DONE | CANCELLED
  followUpAt         DateTime
  followUpNotifiedAt DateTime?
  followUpDoneAt     DateTime?
  startScore         Int?
  endScore           Int?
  outcome            String? // IMPROVED | SAME | WORSE
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([studentId, status])
  @@index([status, followUpAt])
  @@index([flagId])
  @@map("support_plans")
}

// Course AI tutor: the text the tutor answers from — course materials (read once) and teacher notes.
model CourseSource {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  materialId String?  @unique // set for course materials; null for teacher notes
  title      String
  kind       String // material | note
  text       String
  chars      Int      @default(0)
  status     String   @default("READY") // READY | FAILED
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([courseId])
  @@map("course_sources")
}

// A student's flashcards, reviewed with spaced repetition (SM-2).
model StudyCard {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String?
  front       String
  back        String
  sourceTitle String?
  due         DateTime @default(now())
  interval    Int      @default(0) // days
  ease        Float    @default(2.5)
  reps        Int      @default(0)
  lapses      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, due])
  @@map("study_cards")
}

// Verified impact reports for sponsors / partners: figures from verified credentials for a period,
// frozen and signed when issued (data + jwt), shared by an unguessable link.
model ImpactReport {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  organization  String? // only credentials issued with this organisation; null = all
  periodStart   DateTime
  periodEnd     DateTime
  data          Json
  jwt           String // signed snapshot of `data`
  isPublic      Boolean  @default(true)
  views         Int      @default(0)
  createdById   String
  createdByName String
  createdAt     DateTime @default(now())

  @@map("impact_reports")
}

// LTI 1.3: LMS platforms (Moodle, Canvas…) registered by an admin, and the links between their
