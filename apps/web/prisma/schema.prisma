// Database for the web app: Cloudflare D1 (SQLite). Migrations live in ./migrations and are
// applied with `wrangler d1 migrations apply`; see DEPLOY-CLOUDFLARE.md.
generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ─── ENUMS ─────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  TEACHER
  ADMIN
  INDUSTRY_MENTOR
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum GradeStatus {
  PENDING
  GRADED
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AnnouncementTarget {
  ALL
  STUDENTS
  TEACHERS
  COURSE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentType {
  TUITION
  EXAM_FEE
  LIBRARY_FEE
  ACTIVITY_FEE
  ORGANIZATION
  OTHER
}

enum FileType {
  PDF
  DOCX
  VIDEO
  IMAGE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

// ─── MODELS ────────────────────────────────────────────────────────────────

model User {
  id          String     @id @default(cuid())
  name        String
  email       String     @unique
  firebaseUid String?    @unique
  role        Role       @default(STUDENT)
  status      UserStatus @default(PENDING)
  avatar      String?
  googleId    String?    @unique
  phone       String?
  dateOfBirth DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  emailNotifications Boolean   @default(true)
  termsVersion       String? // version of the Terms & Privacy the person accepted
  termsAcceptedAt    DateTime?
  onboardedAt        DateTime? // finished registration (picked a role / name); null = signed in but never registered
  accountType        String? // STUDENT | INDEPENDENT | STAFF | ORGANIZATION (what they chose at sign-up)
  lastSeenAt         DateTime?
  // Study streak (src/server/streaks.ts): days in a row with a quiz, flashcard review or tutor question.
  streakCurrent      Int       @default(0)
  streakBest         Int       @default(0)
  streakLastDay      String? // YYYY-MM-DD in the student's time zone
  chatMutedUntil     DateTime? // owner console: can't send chat messages until then
  signedOutAt        DateTime? // "sign out everywhere": sign-ins that started before this are refused
  emergencyContacts  Json? // [{ name, relation, phone, email }] (max 5)

  // Profiles
  studentProfile   StudentProfile?
  skillPassport    SkillPassport?
  riskFlags        StudentRiskFlag[]
  studyCards       StudyCard[]
  deletionRequests AccountDeletionRequest[]
  teacherProfile   TeacherProfile?

  // Core Academic
  enrollments           Enrollment[]
  attendance            Attendance[]
  submissions           QuizSubmission[]
  grades                Grade[]
  taughtCourses         Course[]
  materials             Material[]
  announcements         Announcement[]
  knowledgeHubResources KnowledgeHubResource[]
  electiveRequests      ElectiveRequest[]
  majorChangeRequests   MajorChangeRequest[]
  majorReviewed         MajorChangeRequest[]   @relation("MajorReviewer")
  calendarEvents        CalendarEvent[]

  // Messaging & Notifications
  sentMessages     Message[]                 @relation("MessageSender")
  messageReactions MessageReaction[]
  messageStates    MessageUserState[]
  pollVotes        PollVote[]
  conversations    ConversationParticipant[]
  notifications    Notification[]

  // Files & Payments
  uploadedFiles    File[]
  payments         Payment[]
  invoices         Invoice[]
  tickets          Ticket[]
  studentDocuments StudentDocument[]

  // Student Life
  associationMemberships AssociationMembership[]
  roomReservations       RoomReservation[]
  groupMemberships       GroupMembership[]
  groupPosts             GroupPost[]
  createdGroups          Group[]                 @relation("GroupCreator")
  studentConsents        StudentConsent[]
  medicalRecord          MedicalRecord?
  safetyAlerts           SafetyAlert[]           @relation("SafetyReporter")

  loginEvents LoginEvent[]
  uiEvents    UiEvent[]

  // Whiteboards
  boardsOwned      Board[]       @relation("BoardOwner")
  boardMemberships BoardMember[]

  // Applications to become a teacher / NGO representative (approved by an admin)
  roleApplications     RoleApplication[] @relation("RoleApplicant")
  reviewedApplications RoleApplication[] @relation("RoleReviewer")

  // Career & Internships
  careerProfile           CareerProfile?
  skills                  StudentSkill[]
  internshipApplications  InternshipApplication[]
  postedInternships       Internship[]             @relation("InternshipPoster")
  scholarshipApplications ScholarshipApplication[]

  // Impact
  impactPoints           ImpactPoint[]
  ngoProjectApplications NGOProjectApplication[]
  startupApplications    StartupApplication[]
  summitRegistrations    SummitRegistration[]
  foundedStartups        Startup[]               @relation("StartupFounder")
  createdSummits         Summit[]                @relation("SummitCreator")

  // Teacher Collaboration
  mentorshipAsStudent     MentorshipRequest[]    @relation("MentorshipStudent")
  mentorshipAsTeacher     MentorshipRequest[]    @relation("MentorshipTeacher")
  initiatedCollaborations TeacherCollaboration[] @relation("CollaborationInitiator")
  partnerCollaborations   TeacherCollaboration[] @relation("CollaborationPartner")

  // Phase 3: Mentorship & Collaborations
  mentorProfile      MentorProfile?
  studentBookings    MentorshipBooking[]    @relation("StudentBookings")
  teacherProjects    CollaborationProject[] @relation("TeacherProjects")
  projectMemberships CollaborationMember[]  @relation("ProjectMemberships")

  // PWA Push Notifications
  pushSubscriptions PushSubscription[]

  // Feature 7: Proof of Work
  proofOfWork ProofOfWork[]

  // Feature 9: Gamification
  impactLevel Int @default(1)
  impactXP    Int @default(0)

  // Feature 10: Certificates
  impactCertificates ImpactCertificate[]

  // Billing: the organization (and its subscription) this admin owns
  ownedOrganization Organization?
  studyDays         StudyDay[]

  @@index([role])
  @@index([status])
  @@map("users")
}

// ─── BILLING / ORGANIZATION SUBSCRIPTIONS ─────────────────────────────────

enum OrgPlan {
  STARTER
  PRO
  ENTERPRISE
}

model Organization {
  id                   String    @id @default(cuid())
  name                 String
  ownerId              String    @unique
  owner                User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  plan                 OrgPlan   @default(STARTER)
  // Mirrors Stripe's subscription status: active, trialing, past_due, canceled, incomplete...
  subscriptionStatus   String?
  billingInterval      String? // "month" | "year"
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("organizations")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

model StudentProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId  String   @unique @default(cuid())
  department String?
  year       Int      @default(1)
  gpa        Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("student_profiles")
}

model TeacherProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId  String   @unique @default(cuid())
  department  String?
  designation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("teacher_profiles")
}

model Course {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  credits     Int          @default(3)
  department  String?
  status      CourseStatus @default(DRAFT)
  teacherId   String
  teacher     User         @relation(fields: [teacherId], references: [id])
  color       String?
  emoji       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  enrollments           Enrollment[]
  timetableSlots        TimetableSlot[]
  attendance            Attendance[]
  grades                Grade[]
  quizzes               Quiz[]
  materials             Material[]
  announcements         Announcement[]
  knowledgeHubResources KnowledgeHubResource[]
  electiveRequests      ElectiveRequest[]
  calendarEvents        CalendarEvent[]
  riskFlags             StudentRiskFlag[]
  sources               CourseSource[]

  @@index([teacherId])
  @@index([status])
  @@map("courses")
}

model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@map("enrollments")
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  note      String?
  createdAt DateTime         @default(now())

  @@unique([studentId, courseId, date])
  @@index([studentId])
  @@index([courseId])
  @@index([date])
  @@map("attendance")
}

model Grade {
  id             String      @id @default(cuid())
  studentId      String
  student        User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignmentName String
  score          Float
  maxScore       Float       @default(100)
  weight         Float       @default(1)
  status         GradeStatus @default(GRADED)
  feedback       String?
  gradedAt       DateTime    @default(now())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([studentId])
  @@index([courseId])
  @@map("grades")
}

model Quiz {
  id          String     @id @default(cuid())
  courseId    String
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  timeLimit   Int? // minutes
  status      QuizStatus @default(DRAFT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  questions   QuizQuestion[]
  submissions QuizSubmission[]

  @@index([courseId])
  @@map("quizzes")
}

model QuizQuestion {
  id            String @id @default(cuid())
  quizId        String
  quiz          Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question      String
  options       Json // string[]
  correctAnswer String
  points        Float  @default(1)
  order         Int    @default(0)

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizSubmission {
  id          String   @id @default(cuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers     Json // { questionId: answer }
  score       Float?
  maxScore    Float?
  submittedAt DateTime @default(now())

  @@unique([quizId, studentId])
  @@index([quizId])
  @@index([studentId])
  @@map("quiz_submissions")
}

model Material {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  type         FileType @default(OTHER)
  fileUrl      String
  size         String?
  uploadedById String
  uploader     User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([courseId])
  @@index([uploadedById])
  @@map("materials")
}

model KnowledgeHubResource {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String?
  url         String?
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId])
  @@index([authorId])
  @@map("knowledge_hub_resources")
}

model File {
  id           String   @id @default(cuid())
  key          String   @unique // S3 key
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  uploadedById String
  uploader     User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([uploadedById])
  @@map("files")
}

model Announcement {
  id        String             @id @default(cuid())
  title     String
  body      String
  target    AnnouncementTarget @default(ALL)
  courseId  String?
  course    Course?            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User               @relation(fields: [authorId], references: [id])
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([courseId])
  @@index([authorId])
  @@map("announcements")
}

model Conversation {
  id              String   @id @default(cuid())
  isGroup         Boolean  @default(false)
  name            String?
  avatarUrl       String?
  createdById     String?
  disappearingSec Int? // new messages expire after this many seconds (null = off)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  role           String       @default("MEMBER") // MEMBER, ADMIN (group chats)
  typingUntil    DateTime?
  // Per-person chat list preferences
  pinnedAt       DateTime?
  mutedUntil     DateTime?
  archivedAt     DateTime?
  markedUnread   Boolean      @default(false)
  translateTo    String? // auto-translate incoming messages into this language (ISO 639-1); null = off

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  // Rich messages (messaging hub)
  type           String               @default("TEXT") // TEXT, IMAGE, FILE, AUDIO, VIDEO, CALL, SYSTEM
  attachmentUrl  String?
  attachmentName String?
  attachmentSize Int?
  attachmentMime String?
  metadata       Json? // e.g. call room + kind
  replyToId      String?
  replyTo        Message?             @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]            @relation("MessageReplies")
  editedAt       DateTime?
  deletedAt      DateTime?
  expiresAt      DateTime? // disappearing messages
  forwarded      Boolean              @default(false)
  reactions      MessageReaction[]
  userStates     MessageUserState[]
  pollVotes      PollVote[]
  translations   MessageTranslation[]

  pinnedAt   DateTime? // pinned to the top of the chat
  pinnedById String?

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@index([replyToId])
  @@index([expiresAt])
  @@map("messages")
}

// Uploaded files stored in the database (used when no external file storage is configured).
model StoredFile {
  id        String   @id @default(cuid())
  key       String   @unique // random, unguessable id used in the file's URL
  ownerId   String
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([ownerId])
  @@map("stored_files")
}

// Admin-managed campus information: services (dining, transport…), useful links and campus events.
model CampusItem {
  id          String    @id @default(cuid())
  kind        String // SERVICE, LINK, EVENT
  category    String?
  title       String
  description String?
  url         String?
  location    String?
  hours       String?
  startAt     DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([kind])
  @@map("campus_items")
}

/// Per-person state of a message: starred, or hidden ("delete for me").
model MessageUserState {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  starred   Boolean  @default(false)
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId, starred])
  @@map("message_user_states")
}

model PollVote {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  option    Int
  createdAt DateTime @default(now())

  @@unique([messageId, userId, option])
  @@index([messageId])
  @@index([userId])
  @@map("poll_votes")
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
  @@map("message_reactions")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String   @default("info")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, read])
  @@map("notifications")
}

enum RoleApplicationStatus {
  DRAFT // account created as "teacher", details not sent yet
  PENDING // waiting for an admin
  NEEDS_INFO // an admin asked for more information
  APPROVED
  REJECTED
  WITHDRAWN
}

/// A request to become a teacher (or NGO representative). The role is only granted when an admin
/// approves it; until then the account has student permissions.
model RoleApplication {
  id            String                @id @default(cuid())
  userId        String
  user          User                  @relation("RoleApplicant", fields: [userId], references: [id], onDelete: Cascade)
  requestedRole Role                  @default(TEACHER)
  status        RoleApplicationStatus @default(DRAFT)
  source        String                @default("SIGNUP") // SIGNUP (chose the role when signing up) or UPGRADE (existing student)

  // What the applicant tells us
  institution     String?
  department      String?
  position        String? // e.g. Lecturer, Professor, Programme officer
  staffId         String?
  workEmail       String?
  phone           String?
  subjects        String?
  experienceYears Int?
  profileUrl      String? // staff page / LinkedIn
  message         String?
  proofUrl        String? // uploaded ID card / appointment letter
  proofName       String?

  // Review
  adminNote    String? // shown to the applicant: what's missing, or why it was declined
  reviewedById String?
  reviewedBy   User?     @relation("RoleReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  submittedAt  DateTime?
  history      Json? // [{ at, by, byName, type, note }]: submitted, updated, info_requested, approved, ...

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, submittedAt])
  @@index([userId, createdAt])
  @@map("role_applications")
}

/// A collaborative whiteboard. The drawing itself lives in the board's Durable Object
/// (cloudflare/worker.ts → BoardRoom); this row holds who can open it.
model Board {
  id         String        @id @default(cuid())
  title      String
  ownerId    String
  owner      User          @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  linkAccess String        @default("NONE") // NONE, VIEW, EDIT: what anyone signed in with the link can do
  thumbnail  String? // small PNG preview (data URL) for the boards list
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  members    BoardMember[]

  @@index([ownerId, updatedAt])
  @@map("boards")
}

model BoardMember {
  id      String   @id @default(cuid())
  boardId String
  board   Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    String   @default("EDITOR") // EDITOR or VIEWER
  addedAt DateTime @default(now())

  @@unique([boardId, userId])
  @@index([userId])
  @@map("board_members")
}

/// Every change the platform owner makes in the owner console, with the record before and after,
/// so any of them can be undone. Only the owner can see this table.
model OwnerChange {
  id        String    @id @default(cuid())
  ownerId   String
  action    String // UPDATE, DELETE, RESTORE
  model     String // Prisma model name, e.g. "User", "Message"
  recordId  String
  summary   String
  before    Json?
  after     Json?
  undoneAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([model, recordId])
  @@map("owner_changes")
}

/// Sign-ins and app opens: when, how, and from where (for the owner's console).
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   @default("SIGN_IN") // SIGN_IN (typed credentials / Google), SIGN_UP, SESSION (opened the app while signed in)
  method    String? // google, password, phone, demo
  ip        String?
  country   String?
  city      String?
  userAgent String?
  device    String? // "Chrome on Android", ...
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("login_events")
}

/// Who did what: role and status changes, grades, credential decisions, deletions, ...
/// Actor name and role are copied so entries stay readable after a user is deleted.
/// What people do in the app, for the owner console: pages opened and buttons / links clicked,
/// with the time. Never what they type. Kept 90 days (technical logs, Privacy Policy section 8).
model UiEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // VIEW (opened a page), CLICK (pressed a button or link)
  label     String? // the button or link's text, e.g. "Submit quiz"
  path      String // the page it happened on
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("ui_events")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String?
  actorRole  String?
  action     String // e.g. "user.role_changed", "grade.posted"
  targetType String? // "user", "course", "grade", "credential", ...
  targetId   String?
  summary    String // human-readable, e.g. "Changed Bob Smith's role to TEACHER"
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  amount          Float
  currency        String        @default("USD")
  type            PaymentType   @default(OTHER)
  description     String
  status          PaymentStatus @default(PENDING)
  stripePaymentId String?       @unique
  stripeSessionId String?       @unique
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  invoice         Invoice?

  @@index([userId])
  @@map("payments")
}

model Invitation {
  id        String     @id @default(cuid())
  email     String     @unique
  role      Role
  status    UserStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("invitations")
}

model Ticket {
  id          String         @id @default(cuid())
  subject     String
  description String
  category    String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  authorId    String
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([authorId])
  @@index([status])
  @@map("tickets")
}

// ─── STUDENT LIFE ──────────────────────────────────────────────────────────

model Association {
  id          String            @id @default(cuid())
  name        String
  category    String
  description String
  members     Int               @default(0)
  status      AssociationStatus @default(PENDING)
  budget      Float             @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  memberships AssociationMembership[]

  @@map("associations")
}

model AssociationMembership {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  role          String      @default("MEMBER")
  joinedAt      DateTime    @default(now())

  @@unique([userId, associationId])
  @@index([userId])
  @@index([associationId])
  @@map("association_memberships")
}

model Room {
  id        String   @id @default(cuid())
  name      String
  capacity  Int
  amenities String
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations   RoomReservation[]
  timetableSlots TimetableSlot[]

  @@map("rooms")
}

model RoomReservation {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  time      String
  duration  String
  createdAt DateTime @default(now())

  @@unique([roomId, date, time])
  @@index([roomId])
  @@index([userId])
  @@map("room_reservations")
}

// ─── ENUMS (EXTENDED) ──────────────────────────────────────────────────────

enum AssociationStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum DocumentType {
  TRANSCRIPT
  DIPLOMA
  CERTIFICATE
  ID_CARD
  LETTER
  OTHER
}

enum ConsentType {
  MARKETING
  ALUMNI
  PHOTO
  RESEARCH
}

enum MentorshipStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InternshipType {
  FULL_TIME
  PART_TIME
  REMOTE
  HYBRID
}

enum CollaborationType {
  RESEARCH
  PROJECT
  GRANT
  PUBLICATION
}

// ─── ACADEMIC ──────────────────────────────────────────────────────────────

model TimetableSlot {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0=Mon, 6=Sun
  startTime String // "09:00"
  endTime   String // "10:30"
  roomId    String?
  room      Room?    @relation(fields: [roomId], references: [id])
  type      String   @default("LECTURE") // LECTURE, LAB, TUTORIAL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([roomId])
  @@map("timetable_slots")
}

model ElectiveRequest {
  id         String            @id @default(cuid())
  studentId  String
  student    User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status     ApplicationStatus @default(PENDING)
  semesterId String? // e.g. "SPRING_2027"
  note       String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([studentId, courseId, semesterId])
  @@index([studentId])
  @@index([courseId])
  @@map("elective_requests")
}

model MajorChangeRequest {
  id               String            @id @default(cuid())
  studentId        String
  student          User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  requestType      String // "CHANGE_MAJOR", "ADD_MINOR", etc.
  currentMajor     String?
  requestedProgram String
  reason           String
  status           ApplicationStatus @default(PENDING)
  reviewedById     String?
  reviewedBy       User?             @relation("MajorReviewer", fields: [reviewedById], references: [id])
  reviewNote       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([studentId])
  @@index([reviewedById])
  @@map("major_change_requests")
}

// ─── CAREER & INTERNSHIPS ──────────────────────────────────────────────────

model CareerProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline      String?
  bio           String?
  linkedinUrl   String?
  portfolioUrl  String?
  githubUrl     String?
  targetRoles   Json     @default("[]") // string[] — array of target job titles
  targetSectors Json     @default("[]") // string[]
  cvUrl         String?
  isPublic      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("career_profiles")
}

model StudentSkill {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String? // "Technical", "Soft Skill", "Language", etc.
  level        SkillLevel @default(BEGINNER)
  endorsements Int        @default(0)
  createdAt    DateTime   @default(now())

  @@unique([userId, name])
  @@index([userId])
  @@map("student_skills")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  sector      String?
  description String?
  logoUrl     String?
  websiteUrl  String?
  location    String?
  size        String? // "1-10", "11-50", "50-200", "200+"
  isPartner   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  internships  Internship[]
  partnerships Partnership[]

  @@map("companies")
}

model Internship {
  id          String         @id @default(cuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String
  type        InternshipType @default(FULL_TIME)
  location    String?
  duration    String? // "3 months", "6 months"
  isPaid      Boolean        @default(true)
  salary      String?
  openings    Int            @default(1)
  skills      Json           @default("[]") // string[]
  deadline    DateTime?
  startDate   DateTime?
  isActive    Boolean        @default(true)
  postedById  String?
  postedBy    User?          @relation("InternshipPoster", fields: [postedById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  applications InternshipApplication[]

  @@index([companyId])
  @@index([postedById])
  @@map("internships")
}

model InternshipApplication {
  id           String            @id @default(cuid())
  internshipId String
  internship   Internship        @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  studentId    String
  student      User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status       ApplicationStatus @default(PENDING)
  coverLetter  String?
  cvUrl        String?
  appliedAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([internshipId, studentId])
  @@index([internshipId])
  @@index([studentId])
  @@map("internship_applications")
}

// ─── COMMUNITY & GROUPS ────────────────────────────────────────────────────

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String?
  avatarUrl   String?
  isPublic    Boolean  @default(true)
  createdById String
  createdBy   User     @relation("GroupCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members GroupMembership[]
  posts   GroupPost[]

  @@index([createdById])
  @@map("groups")
}

model GroupMembership {
  id       String   @id @default(cuid())
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("MEMBER") // MEMBER, ADMIN, MODERATOR
  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("group_memberships")
}

model GroupPost {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  imageUrl  String?
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([authorId])
  @@map("group_posts")
}

// ─── IMPACT ────────────────────────────────────────────────────────────────

model ImpactPoint {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points     Int
  reason     String // e.g. "NGO Project completion"
  sourceType String // "NGO_PROJECT", "SUMMIT", "STARTUP", etc.
  sourceId   String? // ID of the related record
  awardedAt  DateTime @default(now())

  @@index([userId])
  @@map("impact_points")
}

model NGO {
  id          String   @id @default(cuid())
  name        String
  description String?
  logoUrl     String?
  websiteUrl  String?
  sector      String? // "Education", "Health", etc.
  sdgNumbers  Json     @default("[]") // int[] — UN SDG goals e.g. [4, 13]
  location    String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects NGOProject[]

  @@map("ngos")
}

model NGOProject {
  id             String    @id @default(cuid())
  ngoId          String
  ngo            NGO       @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  name           String
  description    String
  type           String? // "Field", "Remote", "Hybrid"
  location       String?
  duration       String?
  openings       Int       @default(1)
  impactPoints   Int       @default(50)
  skillsRequired Json      @default("[]") // string[]
  sdgNumber      Int?
  deadline       DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  applications         NGOProjectApplication[]
  collaborationProject CollaborationProject?

  @@index([ngoId])
  @@map("ngo_projects")
}

model NGOProjectApplication {
  id         String            @id @default(cuid())
  projectId  String
  project    NGOProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  studentId  String
  student    User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     ApplicationStatus @default(PENDING)
  motivation String?
  appliedAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([projectId, studentId])
  @@index([projectId])
  @@index([studentId])
  @@map("ngo_project_applications")
}

model Startup {
  id           String   @id @default(cuid())
  name         String
  description  String?
  sector       String?
  stage        String? // "Idea", "MVP", "Seed", "Growth"
  logoUrl      String?
  websiteUrl   String?
  foundedById  String?
  foundedBy    User?    @relation("StartupFounder", fields: [foundedById], references: [id])
  impactPoints Int      @default(100)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications StartupApplication[]

  @@index([foundedById])
  @@map("startups")
}

model StartupApplication {
  id         String            @id @default(cuid())
  startupId  String
  startup    Startup           @relation(fields: [startupId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String? // role applied for
  status     ApplicationStatus @default(PENDING)
  motivation String?
  appliedAt  DateTime          @default(now())

  @@unique([startupId, userId])
  @@index([startupId])
  @@index([userId])
  @@map("startup_applications")
}

model Summit {
  id           String   @id @default(cuid())
  title        String
  description  String?
  location     String?
  isVirtual    Boolean  @default(false)
  startDate    DateTime
  endDate      DateTime
  capacity     Int?
  impactPoints Int      @default(30)
  coverUrl     String?
  createdById  String?
  createdBy    User?    @relation("SummitCreator", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  registrations SummitRegistration[]

  @@index([createdById])
  @@map("summits")
}

model SummitRegistration {
  id           String   @id @default(cuid())
  summitId     String
  summit       Summit   @relation(fields: [summitId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  registeredAt DateTime @default(now())

  @@unique([summitId, userId])
  @@index([summitId])
  @@index([userId])
  @@map("summit_registrations")
}

// ─── PARTNERS & PARTNERSHIPS ───────────────────────────────────────────────

model Partner {
  id          String   @id @default(cuid())
  name        String
  type        String // "CORPORATE", "NGO", "ACADEMIC", "GOVERNMENT"
  description String?
  logoUrl     String?
  websiteUrl  String?
  country     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  partnerships Partnership[]

  @@map("partners")
}

model Partnership {
  id          String    @id @default(cuid())
  partnerId   String
  partner     Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id])
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([partnerId])
  @@index([companyId])
  @@map("partnerships")
}

// ─── ADMINISTRATIVE ────────────────────────────────────────────────────────

model StudentDocument {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       DocumentType @default(OTHER)
  title      String
  fileUrl    String
  issuedAt   DateTime?
  expiresAt  DateTime?
  isVerified Boolean      @default(false)
  createdAt  DateTime     @default(now())

  @@index([userId])
  @@map("student_documents")
}

model Invoice {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  number      String        @unique
  amount      Float
  currency    String        @default("USD")
  status      PaymentStatus @default(PENDING)
  dueDate     DateTime?
  paidAt      DateTime?
  description String?
  items       Json // [{label, amount}]
  paymentId   String?       @unique
  payment     Payment?      @relation(fields: [paymentId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@map("invoices")
}

model Scholarship {
  id           String    @id @default(cuid())
  name         String
  description  String?
  amount       Float?
  currency     String    @default("USD")
  provider     String? // "Internal", "Company name", etc.
  deadline     DateTime?
  requirements String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  applications ScholarshipApplication[]

  @@map("scholarships")
}

model ScholarshipApplication {
  id            String            @id @default(cuid())
  scholarshipId String
  scholarship   Scholarship       @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  studentId     String
  student       User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status        ApplicationStatus @default(PENDING)
  essay         String?
  appliedAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([scholarshipId, studentId])
  @@index([scholarshipId])
  @@index([studentId])
  @@map("scholarship_applications")
}

model StudentConsent {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ConsentType
  granted   Boolean     @default(false)
  grantedAt DateTime?
  revokedAt DateTime?
  updatedAt DateTime    @updatedAt

  @@unique([userId, type])
  @@index([userId])
  @@map("student_consents")
}

// ─── WELLBEING & SAFETY ────────────────────────────────────────────────────

model MedicalRecord {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorName       String?
  doctorPhone      String?
  bloodType        String?
  allergies        Json     @default("[]") // string[]
  conditions       Json     @default("[]") // string[]
  medications      Json     @default("[]") // string[]
  emergencyContact String?
  emergencyPhone   String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@index([userId])
  @@map("medical_records")
}

model SafetyAlert {
  id          String        @id @default(cuid())
  reporterId  String?
  reporter    User?         @relation("SafetyReporter", fields: [reporterId], references: [id])
  title       String
  description String
  location    String?
  severity    AlertSeverity @default(MEDIUM)
  isAnonymous Boolean       @default(false)
  isResolved  Boolean       @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())

  @@index([reporterId])
  @@map("safety_alerts")
}

// ─── COLLABORATION (TEACHER) ───────────────────────────────────────────────

model MentorshipRequest {
  id        String           @id @default(cuid())
  studentId String
  student   User             @relation("MentorshipStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User             @relation("MentorshipTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  topic     String
  message   String?
  status    MentorshipStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  sessions MentorshipSession[]

  @@index([studentId])
  @@index([teacherId])
  @@map("mentorship_requests")
}

model MentorshipSession {
  id          String            @id @default(cuid())
  requestId   String
  request     MentorshipRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  duration    Int // minutes
  meetingUrl  String?
  notes       String?
  isCompleted Boolean           @default(false)
  createdAt   DateTime          @default(now())

  @@index([requestId])
  @@map("mentorship_sessions")
}

model TeacherCollaboration {
  id          String            @id @default(cuid())
  initiatorId String
  initiator   User              @relation("CollaborationInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  partnerId   String
  partner     User              @relation("CollaborationPartner", fields: [partnerId], references: [id], onDelete: Cascade)
  type        CollaborationType @default(PROJECT)
  title       String
  description String?
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([initiatorId])
  @@index([partnerId])
  @@map("teacher_collaborations")
}

// ─── CALENDAR ──────────────────────────────────────────────────────────────

model CalendarEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  color       String?
  type        String   @default("PERSONAL") // PERSONAL, EXAM, DEADLINE, MEETING
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([courseId])
  @@map("calendar_events")
}

// ─── PHASE 3: MENTORSHIP & COLLABORATIONS ──────────────────────────────────

model MentorProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        String?
  jobTitle       String?
  skills         Json     @default("[]") // string[]
  hoursCommitted Int      @default(0)
  isAvailable    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bookings MentorshipBooking[]

  @@map("mentor_profiles")
}

model MentorshipBooking {
  id        String        @id @default(cuid())
  mentorId  String
  mentor    MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  studentId String
  student   User          @relation("StudentBookings", fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime
  time      String
  topic     String?
  status    String        @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([mentorId])
  @@index([studentId])
  @@map("mentorship_bookings")
}

model CollaborationProject {
  id                   String      @id @default(cuid())
  title                String
  description          String
  partner              String?
  ngo                  String?
  status               String      @default("PendingReview") // PendingReview, Recruiting, Active, Completed, Rejected
  deadline             DateTime?
  tags                 Json        @default("[]") // string[]
  contactEmail         String?
  supervisingTeacherId String?
  supervisingTeacher   User?       @relation("TeacherProjects", fields: [supervisingTeacherId], references: [id])
  ngoProjectId         String?     @unique
  ngoProject           NGOProject? @relation(fields: [ngoProjectId], references: [id])
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  milestones ProjectMilestone[]
  members    CollaborationMember[]

  @@index([supervisingTeacherId])
  @@map("collaboration_projects")
}

model CollaborationMember {
  id        String               @id @default(cuid())
  projectId String
  project   CollaborationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User                 @relation("ProjectMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role      String               @default("STUDENT") // STUDENT, LEAD
  joinedAt  DateTime             @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("collaboration_members")
}

model ProjectMilestone {
  id          String               @id @default(cuid())
  projectId   String
  project     CollaborationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String               @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  dueDate     DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([projectId])
  @@map("project_milestones")
}

// ─── FEATURE 7: PROOF OF WORK VERIFICATION ─────────────────────────────────

enum ProofStatus {
  PENDING
  VERIFIED
  REJECTED
}

model ProofOfWork {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectName    String
  organization   String
  description    String?
  hoursCompleted Int         @default(0)
  codeCommits    Int         @default(0)
  ngoVerified    Boolean     @default(false)
  blockchainHash String?
  status         ProofStatus @default(PENDING)
  evidenceUrl    String?
  verifiedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId])
  @@map("proof_of_work")
}

// ─── FEATURE 8: SOCIAL PROOF FEED ──────────────────────────────────────────

model ActivityFeedItem {
  id         String   @id @default(cuid())
  userId     String?
  userName   String
  userAvatar String?
  university String?
  emoji      String   @default("⭐")
  title      String
  subtitle   String?
  category   String   @default("general") // volunteer, milestone, hackathon, partnership, badge
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@map("activity_feed_items")
}

// ─── FEATURE 10: BUILT-IN CERTIFICATION SYSTEM ─────────────────────────────

enum CertificateStatus {
  DRAFT
  ISSUED
  REVOKED
}

model ImpactCertificate {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  certificateCode String            @unique
  title           String
  projectName     String
  organization    String
  hoursCompleted  Int               @default(0)
  peopleImpacted  Int               @default(0)
  description     String?
  status          CertificateStatus @default(ISSUED)
  blockchainHash  String?
  issuedAt        DateTime          @default(now())
  expiresAt       DateTime?
  linkedinUrl     String?

  // Verification & signing (Phase 1: trustworthy credentials)
  // DRAFT = requested by student, awaiting admin verification.
  evidenceUrl    String?
  requestedAt    DateTime  @default(now())
  verifiedById   String?
  verifiedByName String?
  signature      String? // Ed25519 signature (base64url) over the canonical credential payload
  signatureAlg   String? // e.g. "Ed25519"
  signingKeyId   String? // fingerprint of the public key that signed it
  revokedAt      DateTime?
  revokedReason  String?

  // Public blockchain anchoring (Polygon): the credential hash is written into a transaction
  anchorStatus  String? // PENDING | CONFIRMED | FAILED
  anchorTxHash  String?
  anchorChainId Int?
  anchorNetwork String? // e.g. "Polygon Amoy (testnet)"
  anchoredAt    DateTime?
  anchorError   String?

  @@index([userId])
  @@index([certificateCode])
  @@index([status])
  @@index([anchorStatus])
  @@map("impact_certificates")
}

/// Errors seen in browsers and on the server, grouped: the same problem is one row with a count.
/// Diagnosed by AI (the daily job or the owner console) and shown to the owner at /console.
model ErrorReport {
  id          String    @id @default(cuid())
  fingerprint String    @unique // hash of source + kind + normalised message + first stack frame
  source      String // CLIENT, SERVER
  kind        String // runtime, promise, render, api, chunk
  message     String
  stack       String?
  path        String? // page or API path, no query string
  userAgent   String?
  lastUserId  String?
  count       Int       @default(1)
  users       Int       @default(1) // rough number of different people affected
  status      String    @default("NEW") // NEW, DIAGNOSED, RESOLVED, IGNORED
  diagnosis   String? // AI: likely cause, where to look, suggested fix
  severity    String? // AI: low, medium, high
  diagnosedAt DateTime?
  resolvedAt  DateTime?
  firstSeen   DateTime  @default(now())
  lastSeen    DateTime  @default(now())

  @@index([status, lastSeen])
  @@map("error_reports")
}

/// Machine translations of chat messages, one per message and language, shared by everyone in the
/// conversation (so a group of 30 costs one translation, not 30). Deleted when the message is edited.
model MessageTranslation {
  id         String   @id @default(cuid())
  messageId  String
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  lang       String // target language (ISO 639-1)
  sourceLang String // detected language of the original
  text       String // the translation; empty when the message was already in `lang`
  createdAt  DateTime @default(now())

  @@unique([messageId, lang])
  @@map("message_translations")
}

// Skills passport: a public page a student can choose to share (verified credentials, skills,
// courses), and Open Badges 3.0 exports of their credentials.
model SkillPassport {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug            String   @unique // random, part of the public link
  isPublic        Boolean  @default(false)
  headline        String?
  showSkills      Boolean  @default(true)
  showCredentials Boolean  @default(true)
  showCourses     Boolean  @default(false)
  showImpact      Boolean  @default(true)
  views           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("skill_passports")
}

// Early warning: students who may be struggling in a course, found each day from attendance,
// grades, missed quizzes and inactivity (plain rules, no AI). Only teachers and admins see them,
// and a person decides what to do — nothing happens to the student automatically.
model StudentRiskFlag {
  id            String    @id @default(cuid())
  studentId     String
  student       User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  score         Int // 0–100
  level         String // AT_RISK | WATCH | OK (improved since it was flagged)
  reasons       Json // [{ code, text }]
  status        String    @default("OPEN") // OPEN | CONTACTED | RESOLVED | DISMISSED
  note          String?
  handledById   String?
  handledByName String?
  handledAt     DateTime?
  handledScore  Int? // score when it was last handled (reopens only if it gets clearly worse)
  computedAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([status])
  @@map("student_risk_flags")
}

// Course AI tutor: the text the tutor answers from — course materials (read once) and teacher notes.
model CourseSource {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  materialId String?  @unique // set for course materials; null for teacher notes
  title      String
  kind       String // material | note
  text       String
  chars      Int      @default(0)
  status     String   @default("READY") // READY | FAILED
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([courseId])
  @@map("course_sources")
}

// A student's flashcards, reviewed with spaced repetition (SM-2).
model StudyCard {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String?
  front       String
  back        String
  sourceTitle String?
  due         DateTime @default(now())
  interval    Int      @default(0) // days
  ease        Float    @default(2.5)
  reps        Int      @default(0)
  lapses      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, due])
  @@map("study_cards")
}

// Verified impact reports for sponsors / partners: figures from verified credentials for a period,
// frozen and signed when issued (data + jwt), shared by an unguessable link.
model ImpactReport {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  organization  String? // only credentials issued with this organisation; null = all
  periodStart   DateTime
  periodEnd     DateTime
  data          Json
  jwt           String // signed snapshot of `data`
  isPublic      Boolean  @default(true)
  views         Int      @default(0)
  createdById   String
  createdByName String
  createdAt     DateTime @default(now())

  @@map("impact_reports")
}

// LTI 1.3: LMS platforms (Moodle, Canvas…) registered by an admin, and the links between their
// users / course contexts and UniVerse accounts / courses.
model LtiPlatform {
  id            String   @id @default(cuid())
  name          String
  issuer        String
  clientId      String
  deploymentIds Json     @default("[]") // string[]; empty = any
  authLoginUrl  String
  authTokenUrl  String?
  jwksUrl       String
  trustEmails   Boolean  @default(false) // link to existing accounts by email
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([issuer, clientId])
  @@map("lti_platforms")
}

// One-time OIDC state + nonce for a launch in progress (valid 10 minutes).
model LtiNonce {
  id            String   @id @default(cuid())
  platformId    String
  state         String   @unique
  nonce         String   @unique
  targetLinkUri String?
  used          Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@map("lti_nonces")
}

model LtiUser {
  id         String   @id @default(cuid())
  platformId String
  sub        String
  userId     String
  createdAt  DateTime @default(now())

  @@unique([platformId, sub])
  @@index([userId])
  @@map("lti_users")
}

model LtiContext {
  id         String   @id @default(cuid())
  platformId String
  contextId  String
  courseId   String
  title      String
  createdAt  DateTime @default(now())

  @@unique([platformId, contextId])
  @@map("lti_contexts")
}

// "Delete my account" requests: the person asks, the platform owner reviews (to stop abuse, e.g.
// someone else deleting an account from an unlocked device) and approves or declines.
model AccountDeletionRequest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String // kept for the owner's review list
  name        String
  reason      String?
  status      String    @default("PENDING") // PENDING | APPROVED | DECLINED | CANCELLED
  decidedById String?
  decidedAt   DateTime?
  note        String? // owner's note (sent to the person when declined)
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([userId])
  @@map("account_deletion_requests")
}

/// The spending guard (cloudflare/usage-guard.ts): one row ("main") with this billing month's
/// Cloudflare usage, checked every 15 minutes. While `paused` is on, the app shows a "taking a
/// break" page instead of running, so the Workers Paid plan never costs more than its $5.
model UsageGuard {
  id        String    @id // always "main"
  paused    Boolean   @default(false)
  reason    String? // which allowance ran low, in plain words
  resumeAt  DateTime? // when the next billing month starts (unknown without CF_BILLING_DAY)
  meters    String? // JSON: [{ key, label, used, limit }]
  alerted   String? // the last email sent, "<month>:<warn|pause>", so each is sent once
  error     String? // why the last check couldn't read the usage
  checkedAt DateTime?
  pausedAt  DateTime?

  @@map("usage_guard")
}

/// The owner's server switch (owner console → Server), one row ("main"), read by the Worker
/// (cloudflare/usage-guard.ts) at most once a minute:
///   LIVE: normal. READ_ONLY: everyone can look around but nothing can be changed.
///   MAINTENANCE: everyone sees a "back soon" page. The owner always gets through (uv_owner cookie).
model ServerControl {
  id         String    @id // always "main"
  mode       String    @default("LIVE") // LIVE, READ_ONLY, MAINTENANCE
  message    String? // shown to people while not LIVE
  until      DateTime? // back to LIVE by itself at this time
  banner     String? // a notice shown at the top of every page while set
  bypass     String // the owner's pass (uv_owner cookie), set when the row is created
  updatedAt  DateTime  @default(now())
  updatedBy  String?
  switches   String? // JSON list of features turned off, e.g. ["ai","uploads"] (src/lib/feature-switches.ts)
  watchWords String? // words that alert the owner when they appear in a chat, one per line
  aiLimits   String? // JSON { student, staff, site }: AI requests allowed per day (src/server/ai-budget.ts)

  @@map("server_control")
}

/// AI requests per person per UTC day ("YYYY-MM-DD"); userId "*" is the whole site (src/server/ai-budget.ts).
model AiUsage {
  day    String
  userId String
  calls  Int    @default(0)

  @@id([day, userId])
  @@map("ai_usage")
}

/// Saved AI answers, handed out again for the same question instead of asking AI (src/server/ai-budget.ts).
model AiCache {
  key       String   @id
  value     String
  createdAt DateTime @default(now())

  @@map("ai_cache")
}

/// One row per student per day they studied (src/server/streaks.ts).
model StudyDay {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day     String // YYYY-MM-DD in the student's time zone
  actions Int    @default(1)

  @@id([userId, day])
  @@map("study_days")
}
