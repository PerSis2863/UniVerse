model LtiContext {
  id         String   @id @default(cuid())
  platformId String
  contextId  String
  courseId   String
  title      String
  createdAt  DateTime @default(now())

  @@unique([platformId, contextId])
  @@map("lti_contexts")
}

// "Delete my account" requests: the person asks, the platform owner reviews (to stop abuse, e.g.
// someone else deleting an account from an unlocked device) and approves or declines.
model AccountDeletionRequest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String // kept for the owner's review list
  name        String
  reason      String?
  status      String    @default("PENDING") // PENDING | APPROVED | DECLINED | CANCELLED
  decidedById String?
  decidedAt   DateTime?
  note        String? // owner's note (sent to the person when declined)
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([userId])
  @@map("account_deletion_requests")
}

/// The spending guard (cloudflare/usage-guard.ts): one row ("main") with this billing month's
/// Cloudflare usage, checked every 15 minutes. While `paused` is on, the app shows a "taking a
/// break" page instead of running, so the Workers Paid plan never costs more than its $5.
model UsageGuard {
  id        String    @id // always "main"
  paused    Boolean   @default(false)
  reason    String? // which allowance ran low, in plain words
  resumeAt  DateTime? // when the next billing month starts (unknown without CF_BILLING_DAY)
  meters    String? // JSON: [{ key, label, used, limit }]
  alerted   String? // the last email sent, "<month>:<warn|pause>", so each is sent once
  error     String? // why the last check couldn't read the usage
  checkedAt DateTime?
  pausedAt  DateTime?

  @@map("usage_guard")
}

/// The owner's server switch (owner console → Server), one row ("main"), read by the Worker
/// (cloudflare/usage-guard.ts) at most once a minute:
///   LIVE: normal. READ_ONLY: everyone can look around but nothing can be changed.
///   MAINTENANCE: everyone sees a "back soon" page. The owner always gets through (uv_owner cookie).
model ServerControl {
  id         String    @id // always "main"
  mode       String    @default("LIVE") // LIVE, READ_ONLY, MAINTENANCE
  message    String? // shown to people while not LIVE
  until      DateTime? // back to LIVE by itself at this time
  banner     String? // a notice shown at the top of every page while set
  bypass     String // the owner's pass (uv_owner cookie), set when the row is created
  updatedAt  DateTime  @default(now())
  updatedBy  String?
  switches   String? // JSON list of features turned off, e.g. ["ai","uploads"] (src/lib/feature-switches.ts)
  watchWords String? // words that alert the owner when they appear in a chat, one per line
  aiLimits   String? // JSON { student, staff, site }: AI requests allowed per day (src/server/ai-budget.ts)
  aiModels   String? // JSON { text: string[], live: string }: which Gemini models answer (src/server/ai-models.ts)

  @@map("server_control")
}

/// AI requests per person per UTC day ("YYYY-MM-DD"); userId "*" is the whole site (src/server/ai-budget.ts).
model AiUsage {
  day    String
  userId String
  calls  Int    @default(0)

  @@id([day, userId])
  @@map("ai_usage")
}

/// Saved AI answers, handed out again for the same question instead of asking AI (src/server/ai-budget.ts).
model AiCache {
  key       String   @id
  value     String
  createdAt DateTime @default(now())

  @@map("ai_cache")
}

/// One row per student per day they studied (src/server/streaks.ts).
model StudyDay {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day     String // YYYY-MM-DD in the student's time zone
  actions Int    @default(1)

  @@id([userId, day])
  @@map("study_days")
}

/// Smart study planner (upgrade 6): a study session placed in the student's free time by a plain
/// scheduler (no AI): free time = the week minus classes and calendar events; tasks = due work,
/// flashcards due and weaker courses; a daily cap the student sets. Re-planned when the page opens
/// and something changed. Times are the student's local time.
model PlanBlock {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       String // YYYY-MM-DD (local)
  start      String // HH:MM (local)
  end        String // HH:MM (local)
  kind       String // DEADLINE | QUIZ | EXAM | FLASHCARDS | REVIEW
  refId      String? // the deadline / course it's for
  title      String
  courseCode String?
  done       Boolean  @default(false)
  pinned     Boolean  @default(false) // moved by the student: kept when re-planning
  movedFrom  String? // "YYYY-MM-DD HH:MM" when the scheduler moved it
  createdAt  DateTime @default(now())

  @@index([userId, date])
  @@map("plan_blocks")
}

/// A written assignment with a rubric (src/server/assignments.ts).
model Assignment {
  id           String                 @id @default(cuid())
  courseId     String
  course       Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdById  String?
  createdBy    User?                  @relation("AssignmentAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  title        String
  instructions String
  rubric       Json // [{ id, criterion, description?, points }]
  maxScore     Float
  weight       Float                  @default(1)
  dueDate      DateTime?
  status       String                 @default("OPEN") // OPEN, CLOSED
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  submissions  AssignmentSubmission[]

  @@index([courseId])
  @@index([createdById])
  @@map("assignments")
}

/// A student's answer, the AI's draft grade and the teacher's final grade.
model AssignmentSubmission {
  id                 String     @id @default(cuid())
  assignmentId       String
  assignment         Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId          String
  student            User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  text               String
  status             String     @default("SUBMITTED") // SUBMITTED, DRAFTED (AI draft ready), RETURNED (graded)
  aiDraft            Json? // { criteria: [{ id, score, comment }], summary, strengths, improvements, concerns }
  aiDraftedAt        DateTime?
  criteriaScores     Json? // the teacher's final [{ id, score, comment }]
  score              Float?
  feedback           String?
  gradeId            String? // the row in "grades" written when returned
  signals            Json? // similarity signals for the teacher: { sig, material } (src/server/similarity.ts)
  /// Feedback studio (upgrade 8): the teacher's recorded voice or video feedback, its transcript,
  /// and writing-style signals compared with the student's own earlier answers (a hint, never a verdict)
  feedbackMediaUrl   String?
  feedbackMediaKind  String? // AUDIO | VIDEO
  feedbackTranscript String?
  styleSignals       Json?
  /// Offline-first (upgrade 4): when the student handed it in on their device with no connection
  offlineAt          DateTime?
  submittedAt        DateTime   @default(now())
  returnedAt         DateTime?
  updatedAt          DateTime   @updatedAt

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@map("assignment_submissions")
}

/// A parent or guardian a student keeps informed (src/server/guardians.ts).
model GuardianContact {
  id            String    @id @default(cuid())
  studentId     String
  student       User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  email         String
  name          String?
  token         String    @unique // confirm / manage / stop link in their emails
  confirmedAt   DateTime? // nothing is sent until they confirm
  weeklyDigest  Boolean   @default(true)
  absenceAlerts Boolean   @default(true)
  lastDigestAt  DateTime?
  createdAt     DateTime  @default(now())

  @@unique([studentId, email])
  @@index([confirmedAt])
  @@map("guardian_contacts")
}

/// A live poll during class (src/server/live.ts).
model LivePoll {
  id          String         @id @default(cuid())
  courseId    String
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?          @relation("LivePollAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  question    String
  options     Json // string[]
  status      String         @default("OPEN") // OPEN, CLOSED
  showResults Boolean        @default(false) // students see the results while it's open
  createdAt   DateTime       @default(now())
  closedAt    DateTime?
  votes       LivePollVote[]

  @@index([courseId, status])
  @@index([createdById])
  @@map("live_polls")
}

model LivePollVote {
  pollId    String
  poll      LivePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  option    Int
  createdAt DateTime @default(now())

  @@id([pollId, userId])
  @@index([userId])
  @@map("live_poll_votes")
}

/// A shared code editor for a course (src/server/code-rooms.ts); the code is in its Durable Object.
model CodeRoom {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?    @relation("CodeRoomAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  title       String
  language    String   @default("javascript") // javascript, typescript, python, java, cpp
  locked      Boolean  @default(false) // only the teacher (and the creator) can edit
  tests       String? // JSON [{ name, code }]: the teacher's checks, run in the browser (Stage 4 · 3.6)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId])
  @@index([createdById])
  @@map("code_rooms")
}

/// Emails sent and routine emails skipped per UTC day "YYYY-MM-DD" (src/server/email-budget.ts).
model EmailUsage {
  day     String @id
  sent    Int    @default(0)
  skipped Int    @default(0)

  @@map("email_usage")
}

// A call booked ahead (src/server/scheduled-calls.ts) for a class, a study group or a chat.
// Shown on the Calls page; class calls also go on the class calendar. Members get an in-app and
// push reminder about 15 minutes before (never an email).
model ScheduledCall {
  id              String        @id @default(cuid())
  title           String
  kind            String        @default("video") // video | audio
  startAt         DateTime
  durationMin     Int           @default(60)
  courseId        String?
  course          Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groupId         String?
  group           Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  conversationId  String?
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Chat calls: the CALL message, once someone starts it.
  callId          String?
  calendarEventId String?
  createdById     String?
  createdBy       User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  remindedAt      DateTime?
  createdAt       DateTime      @default(now())

  @@index([startAt])
  @@index([courseId])
  @@index([groupId])
  @@index([conversationId])
  @@index([createdById])
  @@map("scheduled_calls")
}

// A voice tutor session (src/app/(dashboard)/student/voice-tutor): who, which course, how long,
// and the conversation as text (never the audio), for the owner console. Kept 90 days.
model VoiceSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String?
  durationSec Int
  turns       Int      @default(0)
  transcript  String   @default("[]") // JSON: [{ who: 'you' | 'tutor', text }]
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("voice_sessions")
}

/// A class call turned into a study pack (upgrade 1: AI class companion). The teacher turns on
/// "Class notes" in a class call; everyone's captions are collected by the teacher's browser and
/// sent here once, when notes stop. One AI request makes the pack. The transcript (text only,
/// never audio) is deleted after 90 days by the daily job; the pack itself stays with the course.
/// A teacher's office hours (Stage 4 · 4.7; src/server/office-hours.ts): open until when, about what.
/// Students queue in the call room o_<teacherId>.
model OfficeHours {
  teacherId  String    @id
  teacher    User      @relation("OfficeHours", fields: [teacherId], references: [id], onDelete: Cascade)
  open       Boolean   @default(false)
  until      DateTime?
  topic      String?
  /// When the teacher's students were last told office hours opened (at most every few hours).
  notifiedAt DateTime?
  updatedAt  DateTime  @default(now())

  @@index([open, until])
  @@map("office_hours")
}

/// Daily brief (Stage 4 · 4.9): the morning push (on, time zone, hour, next due in UTC) and today's
/// AI brief, one per person per day (src/server/daily-brief.ts).
model DailyBrief {
  userId    String    @id
  user      User      @relation("DailyBrief", fields: [userId], references: [id], onDelete: Cascade)
  push      Boolean   @default(true)
  timeZone  String    @default("UTC")
  hour      Int       @default(7)
  nextAt    DateTime?
  sentAt    DateTime?
  aiDay     String?
  ai        String?
  updatedAt DateTime  @default(now())

  @@index([push, nextAt])
  @@map("daily_briefs")
}

/// The school's safety policy (Stage 4 · 4.10; one row, "main"; src/server/safety.ts): the chat
/// safety check, recording calls with students under 18, quiet hours for them, and whether students
/// without a birth date count as under 18.
model SchoolPolicy {
  id             String   @id
  guard          Boolean  @default(true)
  recordMinors   Boolean  @default(false)
  quietMinors    Boolean  @default(true)
  quietStart     String   @default("22:00")
  quietEnd       String   @default("07:00")
  studentsMinors Boolean  @default(false)
  updatedAt      DateTime @default(now())
  updatedById    String?

  @@map("school_policy")
}

/// Quiet hours (Stage 4 · 4.10): no push notifications between start and end in this time zone.
/// `bySchool`: the school's quiet hours for a student under 18 (they can't turn them off).
model QuietHours {
  userId    String   @id
  user      User     @relation("QuietHours", fields: [userId], references: [id], onDelete: Cascade)
  on        Boolean  @default(true)
  start     String   @default("22:00")
  end       String   @default("07:00")
  timeZone  String   @default("UTC")
  bySchool  Boolean  @default(false)
  updatedAt DateTime @default(now())

  @@index([bySchool])
  @@map("quiet_hours")
}

/// A chat message the safety check flagged for the school's moderators (Stage 4 · 4.10).
model SafetyFlag {
  id             String       @id @default(cuid())
  messageId      String?
  message        Message?     @relation("SafetyFlags", fields: [messageId], references: [id], onDelete: SetNull)
  conversationId String
  conversation   Conversation @relation("SafetyFlags", fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SafetyFlagsSent", fields: [senderId], references: [id], onDelete: Cascade)
  kind           String // bullying, threat, self_harm, sexual, personal_info, hate, other
  severity       String // low, medium, high
  reason         String?
  excerpt        String
  source         String // ai, words
  repeats        Int          @default(0)
  status         String       @default("OPEN") // OPEN, REVIEWED, DISMISSED
  reviewedById   String?
  reviewedAt     DateTime?
  note           String?
  createdAt      DateTime     @default(now())

  @@index([status, createdAt])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("safety_flags")
}

/// A teacher's private note about a student's office hours visit.
model OfficeNote {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation("OfficeNotesWritten", fields: [teacherId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("OfficeNotesAbout", fields: [studentId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([teacherId, createdAt])
  @@index([teacherId, studentId])
  @@map("office_notes")
}

/// "Ask your semester" (Stage 4 · 4.5; src/server/semester.ts): a searchable passage from a class,
/// study pack, material, document, graded work or meeting notes. The full-text index (memory_fts,
/// FTS5) lives beside it in the migration; Prisma doesn't model it.
model MemoryPassage {
  id    Int     @id @default(autoincrement())
  kind  String // transcript | pack | material | doc | work | meeting
  ref   String // the source's id
  scope String // who may search it: course:<id> | doc:<id> | user:<id>
  title String
  body  String
  link  String // where it opens; {portal} = the reader's portal (student, teacher, admin)
  at    Int? // seconds into a class (a transcript passage)
  day   String? // when (YYYY-MM-DD)

  @@index([kind, ref])
  @@index([scope])
  @@map("memory_passages")
}

/// What has been indexed for "Ask your semester", at which version (stamp).
model MemorySource {
  id        String   @id @default(cuid())
  kind      String
  ref       String
  stamp     String
  indexedAt DateTime @default(now())

  @@unique([kind, ref])
  @@map("memory_sources")
}

/// Fair group work (Stage 4 · 4.3): how many edits someone made to a document or code room on a day,
/// counted by the live room (cloudflare/worker.ts CodeRoom) and added up here.
model Contribution {
  id        String   @id @default(cuid())
  userId    String
  tool      String // doc | code
  refId     String // the document or code room
  day       String // YYYY-MM-DD (UTC)
  edits     Int      @default(0)
  bytes     Int      @default(0)
  updatedAt DateTime @default(now())

  @@unique([userId, tool, refId, day])
  @@index([tool, refId, day])
  @@map("contributions")
}

/// How a teammate rates someone's part in a class's or study group's work (1–5), for the teacher.
model PeerRating {
  id        String   @id @default(cuid())
  spaceKind String // course | group
  spaceId   String
  raterId   String
  rater     User     @relation("RatingsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  rateeId   String
  ratee     User     @relation("RatingsReceived", fields: [rateeId], references: [id], onDelete: Cascade)
  score     Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@unique([spaceKind, spaceId, raterId, rateeId])
  @@index([spaceKind, spaceId])
  @@map("peer_ratings")
}

/// A recording of a call that isn't a class (Stage 4 · 2.9; src/server/call-recordings.ts), saved where
/// the call happened; kept 90 days. Class recordings are course materials.
model CallRecording {
  id             String   @id @default(cuid())
  callId         String
  kind           String // chat | room | group | link
  conversationId String? // the chat it was posted to
  groupId        String?
  messageId      String?
  noteId         String? // the call's meeting notes, for chapters and the transcript
  createdById    String
  createdBy      User     @relation("CallRecordings", fields: [createdById], references: [id], onDelete: Cascade)
  url            String
  mime           String
  size           Int      @default(0)
  durationSec    Int      @default(0)
  people         String   @default("[]") // JSON account ids of who was in the call
  createdAt      DateTime @default(now())

  @@index([callId])
  @@index([conversationId])
  @@index([groupId])
  @@index([createdById, createdAt])
  @@map("call_recordings")
}

/// Meeting notes for a call that isn't a class (Stage 4 · 2.8; src/server/meeting-notes.ts): made from
/// the live captions when someone turns notes on, posted where the call happened.
model CallNote {
  id             String   @id @default(cuid())
  callId         String
  kind           String // chat | room | group | link | impact (an impact room's call, 4.12)
  conversationId String? // chat calls and voice rooms: the chat the notes were posted to
  groupId        String? // study group calls
  messageId      String? // the chat message with the notes
  createdById    String
  createdBy      User     @relation("CallNotes", fields: [createdById], references: [id], onDelete: Cascade)
  title          String
  startedAt      DateTime
  durationSec    Int      @default(0)
  status         String   @default("READY") // READY | PENDING (AI wasn't available; can be made later)
  summary        String?
  decisions      String   @default("[]") // JSON string[]
  actions        String   @default("[]") // JSON [{ text, who, due }]
  chapters       String   @default("[]") // JSON [{ t, title }]
  transcript     String? // JSON [{ t, who, text }]; removed after 90 days
  people         String   @default("[]") // JSON user ids of who was in the call (call links have no members to go by)
  createdAt      DateTime @default(now())

  @@index([callId])
  @@index([conversationId])
  @@index([groupId])
  @@index([createdById, createdAt])
  @@map("call_notes")
}

model ClassSession {
  id                  String   @id @default(cuid())
  courseId            String
  course              Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdById         String
  startedAt           DateTime
  durationSec         Int      @default(0)
  status              String   @default("READY") // READY | PENDING (AI wasn't available; the teacher can retry)
  summary             String?
  notes               String   @default("[]") // JSON string[]
  keyMoments          String   @default("[]") // JSON [{ t: seconds from start, text }]
  flashcards          String   @default("[]") // JSON [{ front, back }]
  quizId              String?
  recordingMaterialId String?
  transcript          String? // JSON [{ t, who, text }]; removed after 90 days
  pulse               String   @default("[]") // JSON [{ t, lost, got, total }]: classroom pulse counts over the class (Stage 4 · 4.4)
  reexplain           String   @default("[]") // JSON [{ t, topic, why }]: AI suggestions for the teacher, from the pulse
  chapters            String   @default("[]") // JSON [{ t, title }]: smart replay (Stage 4 · 4.6)
  recap               String? // a recap to read in about two minutes
  practice            String   @default("[]") // JSON [{ question, options, answer (index), explain, t }]: practice questions for students
  createdAt           DateTime @default(now())

  @@index([courseId, createdAt])
  @@map("class_sessions")
}

// Status updates ("stories"), like WhatsApp's: a photo or a coloured text card that disappears
// after 24 hours. Seen by the people you share a chat with (src/app/api/chat/status).
model ChatStatus {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String           @default("TEXT") // TEXT | IMAGE
  body       String           @default("")
  mediaUrl   String?
  background String?
  createdAt  DateTime         @default(now())
  expiresAt  DateTime
  views      ChatStatusView[]

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("chat_statuses")
}

model ChatStatusView {
  statusId String
  status   ChatStatus @relation(fields: [statusId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt DateTime   @default(now())

  @@id([statusId, userId])
  @@index([userId])
  @@map("chat_status_views")
}

// A community (Discord server / WhatsApp community): members, roles and channels
// (conversations with communityId). src/server/communities.ts
model Community {
  id          String            @id @default(cuid())
  name        String
  description String?
  color       String            @default("#4f46e5")
  inviteCode  String            @unique
  discoverable Boolean          @default(false) // listed under Discover, open to anyone in the network (upgrade 9)
  automodWords String? // JSON string[]: words members' messages may not contain (Stage 4 · 1.13)
  automodAction String          @default("BLOCK") // BLOCK (refused) | FLAG (sent, and reported to the moderators)
  createdById String?
  createdAt   DateTime          @default(now())
  members     CommunityMember[]
  channels    Conversation[]
  emoji       CommunityEmoji[]
  reports     CommunityReport[]
  modLog      CommunityModLog[]

  @@map("communities")
}

/// A community's own emoji (Stage 4 · 1.2), up to 50, used as :name: in its channels and reactions.
model CommunityEmoji {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name        String
  url         String
  createdById String?
  createdAt   DateTime  @default(now())

  @@unique([communityId, name])
  @@map("community_emoji")
}

model CommunityMember {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("MEMBER") // OWNER | MOD | MEMBER
  timeoutUntil DateTime? // timed out by a moderator: can read, can't post (Stage 4 · 1.13)
  joinedAt    DateTime  @default(now())

  @@unique([communityId, userId])
  @@index([userId])
  @@map("community_members")
}

/// A message reported to a community's moderators (Stage 4 · 1.13): by a member, or by automod
/// (reporterId null).
model CommunityReport {
  id             String    @id @default(cuid())
  communityId    String
  community      Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  conversationId String
  messageId      String
  reporterId     String?
  senderId       String
  reason         String?
  excerpt        String
  status         String    @default("OPEN") // OPEN | RESOLVED | DISMISSED
  resolvedById   String?
  resolvedAt     DateTime?
  outcome        String? // removed | timeout:<minutes> | dismissed
  createdAt      DateTime  @default(now())

  @@unique([messageId, reporterId])
  @@index([communityId, status])
  @@map("community_reports")
}

/// What a community's moderators did (Stage 4 · 1.13), for the owner and moderators to see.
model CommunityModLog {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  actorId     String?
  action      String // remove_message | timeout | untimeout | remove_member | role | automod | dismiss_report
  targetId    String?
  detail      String?
  createdAt   DateTime  @default(now())

  @@index([communityId, createdAt])
  @@map("community_mod_log")
}

// "/remind" in a chat: an in-app (and push) reminder at a time, sent by the 15-minute cron.
model ChatReminder {
  id             String    @id @default(cuid())
  userId         String
  conversationId String?
  text           String
  dueAt          DateTime
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([dueAt])
  @@index([userId])
  @@map("chat_reminders")
}

// Favourite people (Calls): one-tap calling, and they still reach you in Focus mode.
model FavoritePerson {
  userId     String
  favoriteId String
  createdAt  DateTime @default(now())

  @@id([userId, favoriteId])
  @@map("favorite_people")
}

// Campus network (upgrade 9): universities in one UniVerse deployment. A campus is a group of people
// (from their email domains); courses can be shared with partner campuses, students can go on
// exchange, and communities can be opened to the whole network. src/server/campus-network.ts
model Campus {
  id               String           @id @default(cuid())
  name             String
  country          String?
  city             String?
  logoUrl          String?
  emailDomains     String           @default("[]") // JSON array, e.g. ["uni.edu", "student.uni.edu"]
  lat              Float?
  lng              Float?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  users            User[]
  courses          CourseCampus[]
  exchangeStudents StudentProfile[] @relation("ExchangeCampus")

  @@map("campuses")
}

/// A course shared with a partner campus: that campus's students can see and join it.
model CourseCampus {
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  campusId  String
  campus    Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  addedById String?
  createdAt DateTime @default(now())

  @@id([courseId, campusId])
  @@index([campusId])
  @@map("course_campuses")
}

/// Task boards (Stage 4 · 3.3): Kanban lists of cards, for a person and whoever they add, or for a
/// whole course (src/server/tasks.ts).
model TaskBoard {
  id        String            @id @default(cuid())
  title     String
  ownerId   String
  courseId  String? // everyone in the course can see and edit it
  groupId   String? // or everyone in the study group (Stage 4 · 3.1)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  members   TaskBoardMember[]
  lists     TaskList[]
  tasks     Task[]

  @@index([ownerId])
  @@index([courseId])
  @@index([groupId])
  @@map("task_boards")
}

model TaskBoardMember {
  id      String    @id @default(cuid())
  boardId String
  board   TaskBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId  String
  role    String    @default("EDITOR") // EDITOR or VIEWER
  addedAt DateTime  @default(now())

  @@unique([boardId, userId])
  @@index([userId])
  @@map("task_board_members")
}

model TaskList {
  id        String    @id @default(cuid())
  boardId   String
  board     TaskBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title     String
  position  Float     @default(0)
  createdAt DateTime  @default(now())
  tasks     Task[]

  @@index([boardId])
  @@map("task_lists")
}

model Task {
  id          String        @id @default(cuid())
  boardId     String
  board       TaskBoard     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  listId      String
  list        TaskList      @relation(fields: [listId], references: [id], onDelete: Cascade)
  title       String
  notes       String?
  assigneeId  String?
  dueAt       DateTime?
  position    Float         @default(0)
  checklist   String? // JSON [{ text, done }]
  doneAt      DateTime?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  comments    TaskComment[]

  @@index([boardId])
  @@index([assigneeId, doneAt])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  body      String
  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("task_comments")
}

/// Documents (Stage 4 · 3.2): written together live (Tiptap + Yjs through the CodeRoom Durable
/// Object, room "doc:<id>"); versions and comments here (src/server/docs.ts).
model Doc {
  id        String       @id @default(cuid())
  title     String
  ownerId   String
  courseId  String? // everyone in the course can open and edit it
  groupId   String? // or everyone in the study group (Stage 4 · 3.1)
  conversationId String? @unique // or a chat's canvas: everyone in the chat (Stage 4 · 1.12)
  preview   String? // the start of the text, for lists and search
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  members   DocMember[]
  versions  DocVersion[]
  comments  DocComment[]

  @@index([ownerId])
  @@index([courseId])
  @@index([groupId])
  @@map("docs")
}

model DocMember {
  id      String   @id @default(cuid())
  docId   String
  doc     Doc      @relation(fields: [docId], references: [id], onDelete: Cascade)
  userId  String
  role    String   @default("EDITOR") // EDITOR or VIEWER
  addedAt DateTime @default(now())

  @@unique([docId, userId])
  @@index([userId])
  @@map("doc_members")
}

model DocVersion {
  id        String   @id @default(cuid())
  docId     String
  doc       Doc      @relation(fields: [docId], references: [id], onDelete: Cascade)
  html      String
  authorId  String
  name      String? // a version someone named ("Before feedback")
  createdAt DateTime @default(now())

  @@index([docId, createdAt])
  @@map("doc_versions")
}

model DocComment {
  id         String    @id @default(cuid())
  docId      String
  doc        Doc       @relation(fields: [docId], references: [id], onDelete: Cascade)
  userId     String
  quote      String? // the text it's about
  body       String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([docId])
  @@map("doc_comments")
}
