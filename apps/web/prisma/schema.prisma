// Database for the web app: Cloudflare D1 (SQLite). Migrations live in ./migrations and are
// applied with `wrangler d1 migrations apply`; see DEPLOY-CLOUDFLARE.md.
generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ─── ENUMS ─────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  TEACHER
  ADMIN
  INDUSTRY_MENTOR
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum GradeStatus {
  PENDING
  GRADED
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AnnouncementTarget {
  ALL
  STUDENTS
  TEACHERS
  COURSE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentType {
  TUITION
  EXAM_FEE
  LIBRARY_FEE
  ACTIVITY_FEE
  ORGANIZATION
  OTHER
}

enum FileType {
  PDF
  DOCX
  VIDEO
  IMAGE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

// ─── MODELS ────────────────────────────────────────────────────────────────

model User {
  id          String     @id @default(cuid())
  name        String
  /// My chat folders (Stage 4 · 1.6), JSON: [{ id, name, emoji, chatIds }] (src/app/api/chat/folders).
  chatFolders String?
  chatSnippets String? // saved replies and templates (Stage 4 · 1.9), JSON
  email       String     @unique
  firebaseUid String?    @unique
  role        Role       @default(STUDENT)
  status      UserStatus @default(PENDING)
  avatar      String?
  googleId    String?    @unique
  phone       String?
  dateOfBirth DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  emailNotifications Boolean   @default(true)
  termsVersion       String? // version of the Terms & Privacy the person accepted
  termsAcceptedAt    DateTime?
  tourDoneAt         DateTime? // skipped or finished the welcome tour (src/components/layout/WelcomeTour.tsx)
  onboardedAt        DateTime? // finished registration (picked a role / name); null = signed in but never registered
  accountType        String? // STUDENT | INDEPENDENT | STAFF | ORGANIZATION (what they chose at sign-up)
  lastSeenAt         DateTime?
  // Study streak (src/server/streaks.ts): days in a row with a quiz, flashcard review or tutor question.
  streakCurrent      Int       @default(0)
  streakBest         Int       @default(0)
  streakLastDay      String? // YYYY-MM-DD in the student's time zone
  chatMutedUntil     DateTime? // owner console: can't send chat messages until then
  signedOutAt        DateTime? // "sign out everywhere": sign-ins that started before this are refused
  emergencyContacts  Json? // [{ name, relation, phone, email }] (max 5)
  // Campus network (upgrade 9): the campus this person belongs to (set from their email domain) and
  // whether people at partner campuses may find them in search.
  campusId           String?
  campus             Campus?   @relation(fields: [campusId], references: [id], onDelete: SetNull)
  networkVisible     Boolean   @default(false)

  // Profiles
  studentProfile   StudentProfile?
  skillPassport    SkillPassport?
  riskFlags        StudentRiskFlag[]
  studyCards       StudyCard[]
  deletionRequests AccountDeletionRequest[]
  teacherProfile   TeacherProfile?

  // Core Academic
  enrollments           Enrollment[]
  attendance            Attendance[]
  submissions           QuizSubmission[]
  grades                Grade[]
  taughtCourses         Course[]
  materials             Material[]
  announcements         Announcement[]
  knowledgeHubResources KnowledgeHubResource[]
  electiveRequests      ElectiveRequest[]
  majorChangeRequests   MajorChangeRequest[]
  majorReviewed         MajorChangeRequest[]   @relation("MajorReviewer")
  calendarEvents        CalendarEvent[]

  // Messaging & Notifications
  sentMessages     Message[]                 @relation("MessageSender")
  messageReactions MessageReaction[]
  messageStates    MessageUserState[]
  pollVotes        PollVote[]
  conversations    ConversationParticipant[]
  notifications    Notification[]

  // Files & Payments
  uploadedFiles    File[]
  payments         Payment[]
  invoices         Invoice[]
  tickets          Ticket[]
  studentDocuments StudentDocument[]

  // Student Life
  associationMemberships AssociationMembership[]
  roomReservations       RoomReservation[]
  groupMemberships       GroupMembership[]
  groupPosts             GroupPost[]
  createdGroups          Group[]                 @relation("GroupCreator")
  studentConsents        StudentConsent[]
  medicalRecord          MedicalRecord?
  safetyAlerts           SafetyAlert[]           @relation("SafetyReporter")

  loginEvents LoginEvent[]
  uiEvents    UiEvent[]

  // Whiteboards
  boardsOwned      Board[]       @relation("BoardOwner")
  boardMemberships BoardMember[]

  // Applications to become a teacher / NGO representative (approved by an admin)
  roleApplications     RoleApplication[] @relation("RoleApplicant")
  reviewedApplications RoleApplication[] @relation("RoleReviewer")

  // Career & Internships
  careerProfile           CareerProfile?
  skills                  StudentSkill[]
  skillEvidence           SkillEvidence[]
  supportPlans            SupportPlan[]
  planBlocks              PlanBlock[]
  shiftCheckins           ShiftCheckin[]
  eventRsvps              EventRsvp[]
  lostFoundItems          LostFoundItem[]
  /// Smart planner settings: JSON { capMin, start, end, ical, sig, plannedFor }
  studyPrefs              String?
  internshipApplications  InternshipApplication[]
  postedInternships       Internship[]             @relation("InternshipPoster")
  scholarshipApplications ScholarshipApplication[]

  // Impact
  impactPoints           ImpactPoint[]
  ngoProjectApplications NGOProjectApplication[]
  startupApplications    StartupApplication[]
  summitRegistrations    SummitRegistration[]
  foundedStartups        Startup[]               @relation("StartupFounder")
  createdSummits         Summit[]                @relation("SummitCreator")

  // Teacher Collaboration
  mentorshipAsStudent     MentorshipRequest[]    @relation("MentorshipStudent")
  mentorshipAsTeacher     MentorshipRequest[]    @relation("MentorshipTeacher")
  initiatedCollaborations TeacherCollaboration[] @relation("CollaborationInitiator")
  partnerCollaborations   TeacherCollaboration[] @relation("CollaborationPartner")

  // Phase 3: Mentorship & Collaborations
  mentorProfile      MentorProfile?
  studentBookings    MentorshipBooking[]    @relation("StudentBookings")
  teacherProjects    CollaborationProject[] @relation("TeacherProjects")
  projectMemberships CollaborationMember[]  @relation("ProjectMemberships")

  // PWA Push Notifications
  pushSubscriptions PushSubscription[]

  // Feature 7: Proof of Work
  proofOfWork ProofOfWork[]

  // Feature 9: Gamification
  impactLevel Int @default(1)
  impactXP    Int @default(0)

  // Feature 10: Certificates
  impactCertificates ImpactCertificate[]

  // Billing: the organization (and its subscription) this admin owns
  ownedOrganization     Organization?
  studyDays             StudyDay[]
  assignmentsCreated    Assignment[]           @relation("AssignmentAuthor")
  assignmentSubmissions AssignmentSubmission[]
  guardianContacts      GuardianContact[]
  impactUpdates         ImpactUpdate[]
  impactFollows         ImpactFollower[]
  timePledges           TimePledge[]
  livePollsCreated      LivePoll[]             @relation("LivePollAuthor")
  livePollVotes         LivePollVote[]
  codeRoomsCreated      CodeRoom[]             @relation("CodeRoomAuthor")

  scheduledCalls       ScheduledCall[]
  voiceSessions        VoiceSession[]
  statuses             ChatStatus[]
  statusViews          ChatStatusView[]
  // Messages: availability (auto | busy | in_class | studying | sleeping | invisible) and a custom
  // status. Busy, in class and sleeping are Focus modes: calls don't ring and pushes wait, except
  // from favourites.
  scheduledMessages    ScheduledMessage[] @relation("ScheduledMessages")
  callNotes            CallNote[]         @relation("CallNotes")
  callRecordings       CallRecording[]    @relation("CallRecordings")
  ratingsGiven         PeerRating[]       @relation("RatingsGiven")
  ratingsReceived      PeerRating[]       @relation("RatingsReceived")
  officeHours          OfficeHours?       @relation("OfficeHours")
  dailyBrief           DailyBrief?        @relation("DailyBrief")
  quietHours           QuietHours?        @relation("QuietHours")
  safetyFlagsSent      SafetyFlag[]       @relation("SafetyFlagsSent")
  officeNotesWritten   OfficeNote[]       @relation("OfficeNotesWritten")
  officeNotesAbout     OfficeNote[]       @relation("OfficeNotesAbout")
  presence             String            @default("auto")
  statusText           String?
  statusEmoji          String?
  statusUntil          DateTime?
  communityMemberships CommunityMember[]

  @@index([role])
  @@index([status])
  @@index([campusId])
  @@map("users")
}

// ─── BILLING / ORGANIZATION SUBSCRIPTIONS ─────────────────────────────────

enum OrgPlan {
  STARTER
  PRO
  ENTERPRISE
}

model Organization {
  id                   String    @id @default(cuid())
  name                 String
  ownerId              String    @unique
  owner                User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  plan                 OrgPlan   @default(STARTER)
  // Mirrors Stripe's subscription status: active, trialing, past_due, canceled, incomplete...
  subscriptionStatus   String?
  billingInterval      String? // "month" | "year"
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("organizations")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

model StudentProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId  String   @unique @default(cuid())
  department String?
  year       Int      @default(1)
  gpa        Float    @default(0)
  // On exchange at a partner campus (upgrade 9): they can also join its courses between these dates.
  exchangeCampusId String?
  exchangeCampus   Campus?   @relation("ExchangeCampus", fields: [exchangeCampusId], references: [id], onDelete: SetNull)
  exchangeFrom     DateTime?
  exchangeUntil    DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([exchangeCampusId])
  @@map("student_profiles")
}

model TeacherProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId  String   @unique @default(cuid())
  department  String?
  designation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("teacher_profiles")
}

model Course {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  /// Skills this course builds (JSON string[], 3–6, chosen by the teacher): graded work becomes evidence for them
  skills      String?
  credits     Int          @default(3)
  department  String?
  status      CourseStatus @default(DRAFT)
  teacherId   String
  teacher     User         @relation(fields: [teacherId], references: [id])
  color       String?
  emoji       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  enrollments           Enrollment[]
  timetableSlots        TimetableSlot[]
  attendance            Attendance[]
  grades                Grade[]
  quizzes               Quiz[]
  classSessions         ClassSession[]
  materials             Material[]
  announcements         Announcement[]
  knowledgeHubResources KnowledgeHubResource[]
  electiveRequests      ElectiveRequest[]
  calendarEvents        CalendarEvent[]
  riskFlags             StudentRiskFlag[]
  sources               CourseSource[]
  assignments           Assignment[]
  livePolls             LivePoll[]
  codeRooms             CodeRoom[]

  scheduledCalls ScheduledCall[]
  campuses       CourseCampus[] // partner campuses it's shared with (upgrade 9)

  @@index([teacherId])
  @@index([status])
  @@map("courses")
}

model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@map("enrollments")
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  note      String?
  createdAt DateTime         @default(now())

  @@unique([studentId, courseId, date])
  @@index([studentId])
  @@index([courseId])
  @@index([date])
  @@map("attendance")
}

model Grade {
  id             String      @id @default(cuid())
  studentId      String
  student        User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignmentName String
  score          Float
  maxScore       Float       @default(100)
  weight         Float       @default(1)
  status         GradeStatus @default(GRADED)
  feedback       String?
  gradedAt       DateTime    @default(now())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([studentId])
  @@index([courseId])
  @@map("grades")
}

model Quiz {
  id          String     @id @default(cuid())
  courseId    String
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  timeLimit   Int? // minutes
  status      QuizStatus @default(DRAFT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  questions   QuizQuestion[]
  submissions QuizSubmission[]

  @@index([courseId])
  @@map("quizzes")
}

model QuizQuestion {
  id            String @id @default(cuid())
  quizId        String
  quiz          Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question      String
  options       Json // string[]
  correctAnswer String
  points        Float  @default(1)
  order         Int    @default(0)

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizSubmission {
  id               String    @id @default(cuid())
  quizId           String
  quiz             Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId        String
  student          User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers          Json // { questionId: answer }
  score            Float?
  maxScore         Float?
  submittedAt      DateTime  @default(now())
  /// Offline-first (upgrade 4): a quiz taken with no connection. When the student started and
  /// finished it on their device, the outbox id (a retried send is saved once), and LATE when it
  /// was finished after the due date (the teacher accepts or removes it) or ACCEPTED
  clientId         String?
  offlineStartedAt DateTime?
  offlineAt        DateTime?
  offlineStatus    String?

  @@unique([quizId, studentId])
  @@index([quizId])
  @@index([studentId])
  @@map("quiz_submissions")
}

model Material {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  type         FileType @default(OTHER)
  fileUrl      String
  size         String?
  uploadedById String
  uploader     User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([courseId])
  @@index([uploadedById])
  @@map("materials")
}

model KnowledgeHubResource {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String?
  url         String?
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId])
  @@index([authorId])
  @@map("knowledge_hub_resources")
}

model File {
  id           String   @id @default(cuid())
  key          String   @unique // S3 key
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  uploadedById String
  uploader     User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([uploadedById])
  @@map("files")
}

model Announcement {
  id        String             @id @default(cuid())
  title     String
  body      String
  target    AnnouncementTarget @default(ALL)
  courseId  String?
  course    Course?            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User               @relation(fields: [authorId], references: [id])
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([courseId])
  @@index([authorId])
  @@map("announcements")
}

model Conversation {
  id              String     @id @default(cuid())
  isGroup         Boolean    @default(false)
  name            String?
  avatarUrl       String?
  createdById     String?
  disappearingSec Int? // new messages expire after this many seconds (null = off)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  // A channel inside a community (Discord-style): TEXT, ANNOUNCE (only moderators post) or VOICE
  // (a drop-in call room). Channels aren't listed under Chats.
  communityId     String?
  community       Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  channelKind     String?
  position        Int        @default(0)
  slowModeSec     Int        @default(0) // seconds between one person's messages (0 = off)

  participants ConversationParticipant[]
  messages     Message[]

  scheduledCalls ScheduledCall[]
  scheduledMessages ScheduledMessage[]
  safetyFlags       SafetyFlag[]       @relation("SafetyFlags")

  @@index([communityId])
  @@map("conversations")
}

/// A message set to send later (Stage 4 · 1.4): sent by the 15-minute cron at its quarter hour,
/// then deleted (src/server/scheduled-messages.ts).
model ScheduledMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("ScheduledMessages", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  replyToId      String?
  sendAt         DateTime
  createdAt      DateTime     @default(now())

  @@index([sendAt])
  @@index([conversationId, senderId])
  @@map("scheduled_messages")
}

/// An earlier version of an edited message (Stage 4 · 1.3): its text and when it was written.
model MessageEdit {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  body      String
  writtenAt DateTime
  createdAt DateTime @default(now())

  @@index([messageId])
  @@map("message_edits")
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  role           String       @default("MEMBER") // MEMBER, ADMIN (group chats)
  typingUntil    DateTime?
  // Per-person chat list preferences
  pinnedAt       DateTime?
  mutedUntil     DateTime?
  archivedAt     DateTime?
  markedUnread   Boolean      @default(false)
  translateTo    String? // auto-translate incoming messages into this language (ISO 639-1); null = off
  draft          String? // what this person was writing here, on any device (Stage 4 · 1.4)
  draftAt        DateTime?

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  // Rich messages (messaging hub)
  type           String               @default("TEXT") // TEXT, IMAGE, FILE, AUDIO, VIDEO, CALL, SYSTEM
  attachmentUrl  String?
  attachmentName String?
  attachmentSize Int?
  attachmentMime String?
  metadata       Json? // e.g. call room + kind
  replyToId      String?
  replyTo        Message?             @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]            @relation("MessageReplies")
  editedAt       DateTime?
  deletedAt      DateTime?
  expiresAt      DateTime? // disappearing messages
  forwarded      Boolean              @default(false)
  reactions      MessageReaction[]
  userStates     MessageUserState[]
  pollVotes      PollVote[]
  translations   MessageTranslation[]
  edits          MessageEdit[]
  safetyFlags    SafetyFlag[]         @relation("SafetyFlags")

  pinnedAt   DateTime? // pinned to the top of the chat
  pinnedById String?

  threadId String? // a reply inside a thread started from this message id (Discord-style)

  /// Offline-first (upgrade 4): the sender's own id for a message queued offline, so a retried send
  /// is saved once
  clientId String?

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@index([replyToId])
  @@index([expiresAt])
  @@index([threadId])
  @@map("messages")
}

// Uploaded files stored in the database (used when no external file storage is configured).
model StoredFile {
  id        String   @id @default(cuid())
  key       String   @unique // random, unguessable id used in the file's URL
  ownerId   String
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([ownerId])
  @@map("stored_files")
}

// Admin-managed campus information: services (dining, transport…), useful links and campus events.
model CampusItem {
  id          String      @id @default(cuid())
  kind        String // SERVICE, LINK, EVENT
  category    String?
  title       String
  description String?
  url         String?
  location    String?
  hours       String?
  startAt     DateTime?
  /// Events (upgrade 7): seats; null means no limit. RSVPs and QR check-ins in event_rsvps
  capacity    Int?
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  rsvps       EventRsvp[]

  @@index([kind])
  @@map("campus_items")
}

/// Campus super-app (upgrade 7): a student's place at an event (GOING, or WAITLIST when it's full)
/// and when they checked in by scanning the event's rotating QR code
model EventRsvp {
  id          String     @id @default(cuid())
  itemId      String
  item        CampusItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String     @default("GOING") // GOING | WAITLIST
  checkedInAt DateTime?
  createdAt   DateTime   @default(now())

  @@unique([itemId, userId])
  @@index([userId])
  @@map("event_rsvps")
}

/// Campus super-app (upgrade 7): something lost or found on campus. Hidden after 30 days.
model LostFoundItem {
  id          String   @id @default(cuid())
  kind        String // LOST | FOUND
  title       String
  description String?
  photoUrl    String?
  location    String?
  reporterId  String
  reporter    User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  status      String   @default("OPEN") // OPEN | RESOLVED | HIDDEN (by an admin)
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([status, expiresAt])
  @@index([reporterId])
  @@map("lost_found_items")
}

/// Per-person state of a message: starred, or hidden ("delete for me").
model MessageUserState {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  starred   Boolean  @default(false)
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId, starred])
  @@map("message_user_states")
}

model PollVote {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  option    Int
  createdAt DateTime @default(now())

  @@unique([messageId, userId, option])
  @@index([messageId])
  @@index([userId])
  @@map("poll_votes")
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
  @@map("message_reactions")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String   @default("info")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, read])
  @@map("notifications")
}

enum RoleApplicationStatus {
  DRAFT // account created as "teacher", details not sent yet
  PENDING // waiting for an admin
  NEEDS_INFO // an admin asked for more information
  APPROVED
  REJECTED
  WITHDRAWN
}

/// A request to become a teacher (or NGO representative). The role is only granted when an admin
/// approves it; until then the account has student permissions.
model RoleApplication {
  id            String                @id @default(cuid())
  userId        String
  user          User                  @relation("RoleApplicant", fields: [userId], references: [id], onDelete: Cascade)
  requestedRole Role                  @default(TEACHER)
  status        RoleApplicationStatus @default(DRAFT)
  source        String                @default("SIGNUP") // SIGNUP (chose the role when signing up) or UPGRADE (existing student)

  // What the applicant tells us
  institution     String?
  department      String?
  position        String? // e.g. Lecturer, Professor, Programme officer
  staffId         String?
  workEmail       String?
  phone           String?
  subjects        String?
  experienceYears Int?
  profileUrl      String? // staff page / LinkedIn
  message         String?
  proofUrl        String? // uploaded ID card / appointment letter
  proofName       String?

  // Review
  adminNote    String? // shown to the applicant: what's missing, or why it was declined
  reviewedById String?
  reviewedBy   User?     @relation("RoleReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  submittedAt  DateTime?
  history      Json? // [{ at, by, byName, type, note }]: submitted, updated, info_requested, approved, ...

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, submittedAt])
  @@index([userId, createdAt])
  @@map("role_applications")
}

/// A collaborative whiteboard. The drawing itself lives in the board's Durable Object
/// (cloudflare/worker.ts → BoardRoom); this row holds who can open it.
model Board {
  id         String        @id @default(cuid())
  title      String
  ownerId    String
  owner      User          @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  linkAccess String        @default("NONE") // NONE, VIEW, EDIT: what anyone signed in with the link can do
  thumbnail  String? // small PNG preview (data URL) for the boards list
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  members    BoardMember[]

  @@index([ownerId, updatedAt])
  @@map("boards")
}

model BoardMember {
  id      String   @id @default(cuid())
  boardId String
  board   Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    String   @default("EDITOR") // EDITOR or VIEWER
  addedAt DateTime @default(now())

  @@unique([boardId, userId])
  @@index([userId])
  @@map("board_members")
}

/// Every change the platform owner makes in the owner console, with the record before and after,
/// so any of them can be undone. Only the owner can see this table.
model OwnerChange {
  id        String    @id @default(cuid())
  ownerId   String
  action    String // UPDATE, DELETE, RESTORE
  model     String // Prisma model name, e.g. "User", "Message"
  recordId  String
  summary   String
  before    Json?
  after     Json?
  undoneAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([model, recordId])
  @@map("owner_changes")
}

/// Sign-ins and app opens: when, how, and from where (for the owner's console).
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   @default("SIGN_IN") // SIGN_IN (typed credentials / Google), SIGN_UP, SESSION (opened the app while signed in)
  method    String? // google, password, phone, demo
  ip        String?
  country   String?
  city      String?
  userAgent String?
  device    String? // "Chrome on Android", ...
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("login_events")
}

/// Who did what: role and status changes, grades, credential decisions, deletions, ...
/// Actor name and role are copied so entries stay readable after a user is deleted.
/// What people do in the app, for the owner console: pages opened and buttons / links clicked,
/// with the time. Never what they type. Kept 90 days (technical logs, Privacy Policy section 8).
model UiEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // VIEW (opened a page), CLICK (pressed a button or link)
  label     String? // the button or link's text, e.g. "Submit quiz"
  path      String // the page it happened on
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("ui_events")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String?
  actorRole  String?
  action     String // e.g. "user.role_changed", "grade.posted"
  targetType String? // "user", "course", "grade", "credential", ...
  targetId   String?
  summary    String // human-readable, e.g. "Changed Bob Smith's role to TEACHER"
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  amount          Float
  currency        String        @default("USD")
  type            PaymentType   @default(OTHER)
  description     String
  status          PaymentStatus @default(PENDING)
  stripePaymentId String?       @unique
  stripeSessionId String?       @unique
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  invoice         Invoice?

  @@index([userId])
  @@map("payments")
}

model Invitation {
  id        String     @id @default(cuid())
  email     String     @unique
  role      Role
  status    UserStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("invitations")
}

model Ticket {
  id          String         @id @default(cuid())
  subject     String
  description String
  category    String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  authorId    String
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([authorId])
  @@index([status])
  @@map("tickets")
}

// ─── STUDENT LIFE ──────────────────────────────────────────────────────────

model Association {
  id          String            @id @default(cuid())
  name        String
  category    String
  description String
  members     Int               @default(0)
  status      AssociationStatus @default(PENDING)
  budget      Float             @default(0)
  /// The club's own space (upgrade 7): a Community with its members
  communityId String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  memberships AssociationMembership[]

  @@map("associations")
}

model AssociationMembership {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  role          String      @default("MEMBER")
  joinedAt      DateTime    @default(now())

  @@unique([userId, associationId])
  @@index([userId])
  @@index([associationId])
  @@map("association_memberships")
}

model Room {
  id        String   @id @default(cuid())
  name      String
  capacity  Int
  amenities String
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations   RoomReservation[]
  timetableSlots TimetableSlot[]

  @@map("rooms")
}

model RoomReservation {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  time      String
  duration  String
  createdAt DateTime @default(now())

  @@unique([roomId, date, time])
  @@index([roomId])
  @@index([userId])
  @@map("room_reservations")
}

// ─── ENUMS (EXTENDED) ──────────────────────────────────────────────────────

enum AssociationStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum DocumentType {
  TRANSCRIPT
  DIPLOMA
  CERTIFICATE
  ID_CARD
  LETTER
  OTHER
}

enum ConsentType {
  MARKETING
  ALUMNI
  PHOTO
  RESEARCH
}

enum MentorshipStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InternshipType {
  FULL_TIME
  PART_TIME
  REMOTE
  HYBRID
}

enum CollaborationType {
  RESEARCH
  PROJECT
  GRANT
  PUBLICATION
}

// ─── ACADEMIC ──────────────────────────────────────────────────────────────

model TimetableSlot {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0=Mon, 6=Sun
  startTime String // "09:00"
  endTime   String // "10:30"
  roomId    String?
  room      Room?    @relation(fields: [roomId], references: [id])
  type      String   @default("LECTURE") // LECTURE, LAB, TUTORIAL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([roomId])
  @@map("timetable_slots")
}

model ElectiveRequest {
  id         String            @id @default(cuid())
  studentId  String
  student    User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status     ApplicationStatus @default(PENDING)
  semesterId String? // e.g. "SPRING_2027"
  note       String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([studentId, courseId, semesterId])
  @@index([studentId])
  @@index([courseId])
  @@map("elective_requests")
}

model MajorChangeRequest {
  id               String            @id @default(cuid())
  studentId        String
  student          User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  requestType      String // "CHANGE_MAJOR", "ADD_MINOR", etc.
  currentMajor     String?
  requestedProgram String
  reason           String
  status           ApplicationStatus @default(PENDING)
  reviewedById     String?
  reviewedBy       User?             @relation("MajorReviewer", fields: [reviewedById], references: [id])
  reviewNote       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([studentId])
  @@index([reviewedById])
  @@map("major_change_requests")
}

// ─── CAREER & INTERNSHIPS ──────────────────────────────────────────────────

model CareerProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline      String?
  bio           String?
  linkedinUrl   String?
  portfolioUrl  String?
  githubUrl     String?
  targetRoles   Json     @default("[]") // string[] — array of target job titles
  targetSectors Json     @default("[]") // string[]
  cvUrl         String?
  isPublic      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("career_profiles")
}

model StudentSkill {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String? // "Technical", "Soft Skill", "Language", etc.
  level        SkillLevel @default(BEGINNER)
  endorsements Int        @default(0)
  createdAt    DateTime   @default(now())

  @@unique([userId, name])
  @@index([userId])
  @@map("student_skills")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  sector      String?
  description String?
  logoUrl     String?
  websiteUrl  String?
  location    String?
  size        String? // "1-10", "11-50", "50-200", "200+"
  isPartner   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  internships  Internship[]
  partnerships Partnership[]

  @@map("companies")
}

model Internship {
  id          String         @id @default(cuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String
  type        InternshipType @default(FULL_TIME)
  location    String?
  duration    String? // "3 months", "6 months"
  isPaid      Boolean        @default(true)
  salary      String?
  openings    Int            @default(1)
  skills      Json           @default("[]") // string[]
  deadline    DateTime?
  startDate   DateTime?
  isActive    Boolean        @default(true)
  postedById  String?
  postedBy    User?          @relation("InternshipPoster", fields: [postedById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  applications InternshipApplication[]

  @@index([companyId])
  @@index([postedById])
  @@map("internships")
}

model InternshipApplication {
  id           String            @id @default(cuid())
  internshipId String
  internship   Internship        @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  studentId    String
  student      User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status       ApplicationStatus @default(PENDING)
  coverLetter  String?
  cvUrl        String?
  appliedAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([internshipId, studentId])
  @@index([internshipId])
  @@index([studentId])
  @@map("internship_applications")
}

// ─── COMMUNITY & GROUPS ────────────────────────────────────────────────────

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String?
  avatarUrl   String?
  isPublic    Boolean  @default(true)
  createdById String
  createdBy   User     @relation("GroupCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members GroupMembership[]
  posts   GroupPost[]

  scheduledCalls ScheduledCall[]

  @@index([createdById])
  @@map("groups")
}

model GroupMembership {
  id       String   @id @default(cuid())
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("MEMBER") // MEMBER, ADMIN, MODERATOR
  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("group_memberships")
}

model GroupPost {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  imageUrl  String?
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([authorId])
  @@map("group_posts")
}

// ─── IMPACT ────────────────────────────────────────────────────────────────

model ImpactPoint {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points     Int
  reason     String // e.g. "NGO Project completion"
  sourceType String // "NGO_PROJECT", "SUMMIT", "STARTUP", etc.
  sourceId   String? // ID of the related record
  awardedAt  DateTime @default(now())

  @@index([userId])
  @@map("impact_points")
}

model NGO {
  id          String   @id @default(cuid())
  name        String
  description String?
  logoUrl     String?
  websiteUrl  String?
  sector      String? // "Education", "Health", etc.
  sdgNumbers  Json     @default("[]") // int[] — UN SDG goals e.g. [4, 13]
  location    String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects NGOProject[]

  @@map("ngos")
}

model NGOProject {
  id             String    @id @default(cuid())
  ngoId          String
  ngo            NGO       @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  name           String
  description    String
  type           String? // "Field", "Remote", "Hybrid"
  location       String?
  duration       String?
  openings       Int       @default(1)
  impactPoints   Int       @default(50)
  skillsRequired Json      @default("[]") // string[]
  sdgNumber      Int?
  deadline       DateTime?
  isActive       Boolean   @default(true)
  roomPublic     Boolean   @default(false) // its impact room has a public page for sponsors (4.12)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  applications         NGOProjectApplication[]
  collaborationProject CollaborationProject?
  shifts               VolunteerShift[]
  impactUpdates        ImpactUpdate[]
  impactFollowers      ImpactFollower[]
  timePledges          TimePledge[]
  impactCalls          ImpactCall[]

  @@index([ngoId])
  @@map("ngo_projects")
}

/// Verified volunteering (upgrade 5): a time slot on an NGO project. Students check in on site by
/// scanning a rotating QR code (or by GPS within radiusM of lat/lng); hours are verified at check-out.
model VolunteerShift {
  id          String         @id @default(cuid())
  projectId   String
  project     NGOProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  startAt     DateTime
  endAt       DateTime
  location    String?
  lat         Float?
  lng         Float?
  radiusM     Int            @default(200)
  capacity    Int            @default(20)
  createdById String?
  createdAt   DateTime       @default(now())
  checkins    ShiftCheckin[]

  @@index([projectId])
  @@index([startAt])
  @@map("volunteer_shifts")
}

/// Verified volunteering (upgrade 5): one student's attendance at one shift
model ShiftCheckin {
  id           String         @id @default(cuid())
  shiftId      String
  shift        VolunteerShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  studentId    String
  student      User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  signedUpAt   DateTime       @default(now())
  checkInAt    DateTime?
  checkOutAt   DateTime?
  method       String? // QR | GPS | MANUAL
  lat          Float?
  lng          Float?
  minutes      Int            @default(0)
  verified     Boolean        @default(false)
  verifiedById String?

  @@unique([shiftId, studentId])
  @@index([studentId])
  @@map("shift_checkins")
}

/// Impact rooms (Stage 4 · 4.12, src/server/impact-rooms.ts): a post in a project's room. Staff
/// (admins, teachers) may make one public (shown on the room's public page); reports of the
/// monthly impact call are kind REPORT.
model ImpactUpdate {
  id        String     @id @default(cuid())
  projectId String
  project   NGOProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  kind      String     @default("UPDATE") // UPDATE | NOTES (impact call notes) | REPORT
  isPublic  Boolean    @default(false)
  callId    String? // the impact call it's about
  createdAt DateTime   @default(now())

  @@index([projectId, createdAt])
  @@index([authorId])
  @@map("impact_updates")
}

/// Someone who follows an impact room: as a volunteer, a sponsor or a supporter.
model ImpactFollower {
  projectId String
  project   NGOProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String     @default("SUPPORTER") // VOLUNTEER | SPONSOR | SUPPORTER
  createdAt DateTime   @default(now())

  @@id([projectId, userId])
  @@index([userId])
  @@map("impact_followers")
}

/// A donation of time: hours a month for some months, checked against verified shift hours.
model TimePledge {
  id            String     @id @default(cuid())
  projectId     String
  project       NGOProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  hoursPerMonth Int
  months        Int        @default(3)
  skill         String?
  note          String?
  startAt       DateTime   @default(now())
  createdAt     DateTime   @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@map("time_pledges")
}

/// The monthly live impact call of a room (call id i_<project>), and its report for sponsors.
model ImpactCall {
  id          String     @id @default(cuid())
  projectId   String
  project     NGOProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  title       String
  report      Json?
  reportAt    DateTime?
  createdById String
  createdAt   DateTime   @default(now())

  @@index([projectId, startsAt])
  @@map("impact_calls")
}

model NGOProjectApplication {
  id         String            @id @default(cuid())
  projectId  String
  project    NGOProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  studentId  String
  student    User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     ApplicationStatus @default(PENDING)
  motivation String?
  appliedAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([projectId, studentId])
  @@index([projectId])
  @@index([studentId])
  @@map("ngo_project_applications")
}

model Startup {
  id           String   @id @default(cuid())
  name         String
  description  String?
  sector       String?
  stage        String? // "Idea", "MVP", "Seed", "Growth"
  logoUrl      String?
  websiteUrl   String?
  foundedById  String?
  foundedBy    User?    @relation("StartupFounder", fields: [foundedById], references: [id])
  impactPoints Int      @default(100)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications StartupApplication[]

  @@index([foundedById])
  @@map("startups")
}

model StartupApplication {
  id         String            @id @default(cuid())
  startupId  String
  startup    Startup           @relation(fields: [startupId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
