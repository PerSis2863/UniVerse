{
  "name": "hyperion-desktop",
  "productName": "Hyperion",
  "version": "1.4.0",
  "description": "Hyperion by UniVerse: maths, code and engineering simulation, as a computer app.",
  "private": true,
  "main": "main.js",
  "author": "UniVerse Impact",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "build": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "com.universeimpact.hyperion",
    "productName": "Hyperion",
    "copyright": "UniVerse Impact",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "asarUnpack": [
      "bin/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "runner.js",
      "ami.js",
      "ami-host.js",
      "bin/**",
      "offline.html",
      "assets/icon.png"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "x64ArchFiles": "**/node_modules/@koromix/**",
      "artifactName": "Hyperion-mac.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Hyperion-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Hyperion"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "artifactName": "Hyperion-linux.${ext}",
      "syncDesktopName": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "PerSis2863",
        "repo": "UniVerse",
        "releaseType": "release"
      }
    ]
  },
  "repository": "github:PerSis2863/UniVerse",
  "desktopName": "hyperion.desktop",
  "dependencies": {
    "koffi": "3.3.7"
  }
}
