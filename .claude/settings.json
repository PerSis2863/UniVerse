{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-secrets.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/suggest-compact.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__runpod__exec-pod",
      "mcp__runpod__stream-pod-logs",
      "mcp__runpod__get-capacity",
      "mcp__runpod__get-balance",
      "mcp__runpod__get-pod",
      "mcp__runpod__list-pods",
      "mcp__runpod__list-secrets",
      "mcp__runpod__describe-tool",
      "mcp__runpod__search-concepts",
      "mcp__Cloudflare_Developer_Platform__search_cloudflare_documentation"
    ]
  }
}
