{
  "name": "universe-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter api start:dev\" \"pnpm --filter web dev\"",
    "build": "pnpm --filter api build && pnpm --filter web build",
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "db:generate": "pnpm --filter database generate",
    "db:migrate": "pnpm --filter database migrate:dev",
    "db:push": "pnpm --filter database db:push",
    "db:seed": "pnpm --filter database seed"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "unrs-resolver",
      "@prisma/client",
      "prisma"
    ]
  }
}