{
  "name": "universe-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "dev:web": "pnpm --filter web dev",
    "db:migrate:local": "pnpm --filter web db:migrate:local"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver",
      "@prisma/client",
      "prisma"
    ],
    "overrides": {
      "nanoid@<3.3.18": "^3.3.18",
      "nanoid@>=4.0.0 <5.1.16": "^5.1.16",
      "lodash-es@<4.18.0": "^4.18.0",
      "serialize-javascript@<7.0.5": "^7.0.5",
      "undici@>=7.28.0 <7.29.1": "^7.29.1",
      "deepmerge-ts@<8.0.0": "^8.0.0"
    }
  },
  "packageManager": "pnpm@10.33.0"
